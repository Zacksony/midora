<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MemoryProbeReferenceDirectory Condition="'$(MemoryProbeReferenceDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\.tmp\memory-stage3\baseline</MemoryProbeReferenceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(MemoryProbeReferenceDirectory)\Midora.*.dll" Exclude="$(MemoryProbeReferenceDirectory)\*.Tests.dll" />
    <Reference Include="$(MemoryProbeReferenceDirectory)\Google.Protobuf.dll" />
    <Reference Include="$(MemoryProbeReferenceDirectory)\Microsoft.CodeAnalysis*.dll" />
  </ItemGroup>
</Project>
