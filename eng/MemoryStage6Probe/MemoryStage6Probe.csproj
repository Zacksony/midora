<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <MemoryProbeReferenceDirectory Condition="'$(MemoryProbeReferenceDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\.tmp\memory-stage6\baseline-build</MemoryProbeReferenceDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(MemoryProbeReferenceDirectory)\Midora.Domain.dll" />
    <Reference Include="$(MemoryProbeReferenceDirectory)\Midora.Compiler.dll" />
    <Reference Include="$(MemoryProbeReferenceDirectory)\Midora.Common.dll" />
    <Reference Include="$(MemoryProbeReferenceDirectory)\Google.Protobuf.dll" />
    <Compile Include="..\MemoryStage5Probe\MemoryGuard.cs" Link="MemoryGuard.cs" />
    <Compile Include="..\MemoryStage6WpfProbe\ProcessMemoryMap.cs" Link="ProcessMemoryMap.cs" />
  </ItemGroup>
</Project>
