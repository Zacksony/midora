<Window x:Class="Midora.Desktop.InstrumentSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        FontFamily="{StaticResource Font.UI}" Title="Select Instrument" Width="900" Height="760"
        MinWidth="730" MinHeight="650" WindowStyle="None" ResizeMode="CanResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Surface.0}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" PreviewKeyDown="OnDialogKeyDown"
        Closing="OnClosing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="120"/><RowDefinition Height="Auto"/><RowDefinition Height="58"/>
      </Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseDown">
        <TextBlock Text="Select Instrument" Margin="12,0,50,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
        <Button HorizontalAlignment="Right" Width="46" Height="38" Style="{StaticResource Button.Caption.Close}"
                ToolTip="Close" Click="OnCancelClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>
      <Grid Grid.Row="1" Margin="16,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,12,0">
          <TextBlock Text="BANK MSB · 0–127" Style="{StaticResource Text.Caption}"/>
          <TextBox x:Name="MsbBox" Margin="0,5,0,0" TextChanged="OnValueChanged"/>
          <CheckBox x:Name="MsbOverride" Content="Override inherited MSB" Margin="0,5,0,0" Click="OnOverrideChanged"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,12,0">
          <TextBlock Text="BANK LSB · 0–127" Style="{StaticResource Text.Caption}"/>
          <TextBox x:Name="LsbBox" Margin="0,5,0,0" TextChanged="OnValueChanged"/>
          <CheckBox x:Name="LsbOverride" Content="Override inherited LSB" Margin="0,5,0,0" Click="OnOverrideChanged"/>
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="PROGRAM · 0–127" Style="{StaticResource Text.Caption}"/>
          <TextBox x:Name="ProgramBox" Margin="0,5,0,0" TextChanged="OnValueChanged"/>
          <CheckBox x:Name="ProgramOverride" Content="Override inherited Program" Margin="0,5,0,0" Click="OnOverrideChanged"/>
        </StackPanel>
        <StackPanel x:Name="TimelineTickRow" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" Orientation="Horizontal" Margin="0,10,0,0">
          <TextBlock Text="TICK" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Margin="0,0,12,0"/>
          <TextBox x:Name="TimelineTickBox" Width="210"/>
        </StackPanel>
      </Grid>
      <Grid Grid.Row="2" Margin="16,0,16,12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="BANKS" Margin="0,0,0,6" Style="{StaticResource Text.Caption}"/>
          <ListBox x:Name="BanksList" DisplayMemberPath="Label" SelectionChanged="OnBankSelected"
                   ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </DockPanel>
        <DockPanel Grid.Column="2">
          <TextBlock DockPanel.Dock="Top" Text="PROGRAMS · Select a complete preset" Margin="0,0,0,6" Style="{StaticResource Text.Caption}"/>
          <ListBox x:Name="ProgramsList" DisplayMemberPath="Label" SelectionChanged="OnProgramSelected"
                   ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto"
                   VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
        </DockPanel>
      </Grid>
      <Border Grid.Row="3" Margin="16,0,16,10" Padding="10" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4">
        <StackPanel>
          <WrapPanel>
            <CheckBox x:Name="AutoBox" Content="Automatic preview" Margin="0,0,16,0" VerticalAlignment="Center" Click="OnPreviewSettingsChanged"/>
            <TextBlock Text="Key" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="KeyBox" Width="60" Margin="0,0,12,0" TextChanged="OnPreviewSettingsChanged"/>
            <TextBlock Text="Velocity" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="VelocityBox" Width="60" Margin="0,0,12,0" TextChanged="OnPreviewSettingsChanged"/>
            <TextBlock Text="Gate (ms)" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="DurationBox" Width="85" TextChanged="OnPreviewSettingsChanged"/>
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBlock Text="Preview mode" Margin="0,0,8,0" VerticalAlignment="Center"/>
            <ComboBox x:Name="ModeBox" Width="170" SelectionChanged="OnPreviewSettingsChanged"/>
            <TextBlock Text="Preview only · does not change the track" Margin="12,0,0,0"
                       VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <ScrollViewer x:Name="KeyboardScroll" Grid.Row="4" Margin="16,0,16,8" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Disabled">
        <ui:PianoKeyboardSurface x:Name="PreviewKeyboard" Width="2560" Height="90" StartNote="0" NoteCount="128"
                                 NotePressed="OnPreviewKeyPressed" NoteReleased="OnPreviewKeyReleased"/>
      </ScrollViewer>
      <TextBlock x:Name="StatusText" Grid.Row="5" Margin="16,0,16,8" MinHeight="18" MaxHeight="52" TextWrapping="Wrap"
                 Style="{StaticResource Text.Caption}"/>
      <Border Grid.Row="6" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}"
              BorderThickness="0,1,0,0" Padding="10">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Content="Cancel" Margin="0,0,7,0" Style="{StaticResource Button.Dialog.Cancel}" Click="OnCancelClick"/>
          <Button x:Name="OkButton" Content="OK" Style="{StaticResource Button.Dialog.Confirm}" Click="OnOkClick"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
