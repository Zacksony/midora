<Window x:Class="Midora.Desktop.TimelineGenerationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        xmlns:local="clr-namespace:Midora.Desktop"
        FontFamily="{StaticResource Font.UI}" Title="Batch Create"
        Width="780" Height="700" MinWidth="620" MinHeight="460"
        Background="{StaticResource Brush.Surface.0}" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnDialogPreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
        <TextBlock x:Name="TitleText" Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Batch Create"/>
        <Button Width="46" Height="36" HorizontalAlignment="Right" Style="{StaticResource Button.Caption.Close}" Click="OnCancelClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>
      <ScrollViewer x:Name="ContentScroll" Grid.Row="1" Padding="16,13"
                    HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="ContextText" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="BASE TICK" Style="{StaticResource Text.Caption}" Margin="0,0,0,5"/>
              <TextBox x:Name="BaseTickBox" TextChanged="OnInputChanged" ToolTip="Defaults to the editing cursor. Expressions use relative Ticks from this origin."/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="MAXIMUM CANDIDATES" Style="{StaticResource Text.Caption}" Margin="0,0,0,5"/>
              <TextBox x:Name="MaximumCandidatesBox" Text="65535" TextChanged="OnInputChanged"
                       ToolTip="1–16,777,216. Counts generated candidates before collisions, not retained objects."/>
            </StackPanel>
          </Grid>
          <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
            <CheckBox x:Name="LimitRelativeTickBox" Content="Maximum Relative Start Tick" VerticalAlignment="Center"
                      Checked="OnLimitChanged" Unchecked="OnLimitChanged"/>
            <TextBox x:Name="MaximumRelativeTickBox" Grid.Column="1" Text="0" IsEnabled="False"
                     TextChanged="OnInputChanged" ToolTip="Inclusive limit. Stop before the first candidate whose rounded relative start exceeds it."/>
          </Grid>
          <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
              <Grid Margin="0,0,0,7">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                <TextBlock Text="FIELD" Style="{StaticResource Text.Caption}"/>
                <TextBlock Grid.Column="1" Text="EXPRESSION" Style="{StaticResource Text.Caption}"/>
                <TextBlock Grid.Column="2" Margin="10,0,0,0" Text="INITIAL" Style="{StaticResource Text.Caption}"/>
              </Grid>
              <Grid x:Name="VelocityRow" Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Top" Margin="0,9,8,0" Text="Velocity"/>
                <local:BatchExpressionEditor x:Name="VelocityBox" Grid.Column="1" TextChanged="OnInputChanged" CommitRequested="OnExpressionCommitRequested"/>
                <TextBox x:Name="InitialVelocityBox" Grid.Column="2" Margin="10,0,0,0" Text="1" VerticalAlignment="Top" TextChanged="OnInputChanged"/>
              </Grid>
              <Grid x:Name="PointValueRow" Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Top" Margin="0,9,8,0" Text="Value"/>
                <local:BatchExpressionEditor x:Name="PointValueBox" Grid.Column="1" TextChanged="OnInputChanged" CommitRequested="OnExpressionCommitRequested"/>
                <TextBox x:Name="InitialValueBox" Grid.Column="2" Margin="10,0,0,0" Text="0" VerticalAlignment="Top" TextChanged="OnInputChanged"/>
              </Grid>
              <Grid x:Name="KeyRow" Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Top" Margin="0,9,8,0" Text="Key"/>
                <local:BatchExpressionEditor x:Name="KeyBox" Grid.Column="1" TextChanged="OnInputChanged" CommitRequested="OnExpressionCommitRequested"/>
                <TextBox x:Name="InitialKeyBox" Grid.Column="2" Margin="10,0,0,0" Text="0" VerticalAlignment="Top" TextChanged="OnInputChanged"/>
              </Grid>
              <Grid x:Name="GateRow" Margin="0,0,0,9">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Top" Margin="0,9,8,0" Text="Gate"/>
                <local:BatchExpressionEditor x:Name="GateBox" Grid.Column="1" TextChanged="OnInputChanged" CommitRequested="OnExpressionCommitRequested"/>
                <TextBox x:Name="InitialGateBox" Grid.Column="2" Margin="10,0,0,0" Text="1" VerticalAlignment="Top" TextChanged="OnInputChanged"/>
              </Grid>
              <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Top" Margin="0,9,8,0" Text="Tick"/>
                <local:BatchExpressionEditor x:Name="TickBox" Grid.Column="1" TextChanged="OnInputChanged" CommitRequested="OnExpressionCommitRequested"/>
                <TextBox x:Name="InitialTickBox" Grid.Column="2" Margin="10,0,0,0" Text="0" VerticalAlignment="Top" TextChanged="OnInputChanged"/>
              </Grid>
              <CheckBox x:Name="CreateInitialBox" Content="Create first object from initial values"
                        Checked="OnInputChanged" Unchecked="OnInputChanged"
                        ToolTip="Off: evaluate candidate 0. On: Initial directly creates candidate 0; expressions begin at i=1."/>
            </StackPanel>
          </Border>
          <TextBlock Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,0,0,12"
                     Text="Leave an expression blank to reuse the previous value. Every non-empty expression must start with =. Initial values are normalized for this target. Ctrl+Space opens completion."/>
          <WrapPanel Margin="0,0,0,6">
            <Button Width="86" Margin="0,0,6,6" Content="Help" Click="OnHelpClick"/>
            <Button Width="96" Margin="0,0,6,6" Content="Presets…" Click="OnPresetsClick"/>
            <Button Width="112" Margin="0,0,6,6" Content="Save Preset…" Click="OnSavePresetClick"/>
          </WrapPanel>
          <Border Padding="9,7" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3">
            <TextBlock x:Name="ValidationText" Style="{StaticResource Text.Caption}" Foreground="{StaticResource Brush.Text.Tertiary}"
                       Text="Not validated." TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="12,11" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <Grid>
          <Button Width="90" HorizontalAlignment="Left" Content="Validate" Click="OnValidateClick"/>
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,6,0" IsCancel="True" Style="{StaticResource Button.Dialog.Cancel}" Content="Cancel" Click="OnCancelClick"/>
            <Button IsDefault="True" Style="{StaticResource Button.Dialog.Confirm}" Content="Create" Click="OnCreateClick"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
