<Window x:Class="Midora.Desktop.TimelineGenerationPresetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        FontFamily="{StaticResource Font.UI}" Title="Generation Presets"
        Width="680" Height="470" MinWidth="570" MinHeight="360"
        Background="{StaticResource Brush.Surface.0}" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnDialogPreviewKeyDown">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
        <TextBlock x:Name="TitleText" Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Generation Presets"/>
        <Button Width="46" Height="36" HorizontalAlignment="Right" Style="{StaticResource Button.Caption.Close}" Click="OnCancelClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>
      <Grid Grid.Row="1" Margin="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <ListBox x:Name="PresetList" ItemsSource="{Binding Presets}" DisplayMemberPath="Name"
                 SelectionChanged="OnSelectionChanged" MouseDoubleClick="OnPresetListMouseDoubleClick"
                 ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 PreviewMouseWheel="OnPresetListMouseWheel"/>
        <Border Grid.Column="2" Padding="11,9" Background="{StaticResource Brush.Surface.1}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <TextBlock x:Name="PreviewText" FontFamily="{StaticResource Font.Mono}"
                       Foreground="{StaticResource Brush.Text.Secondary}" TextWrapping="Wrap"/>
          </ScrollViewer>
        </Border>
      </Grid>
      <Border Grid.Row="2" Padding="12,10" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <Grid>
          <Button x:Name="DeleteButton" Width="112" HorizontalAlignment="Left" Content="Delete" IsEnabled="False" Click="OnDeleteClick"/>
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,6,0" IsCancel="True" Style="{StaticResource Button.Dialog.Cancel}" Content="Cancel" Click="OnCancelClick"/>
            <Button x:Name="ApplyButton" IsDefault="True" IsEnabled="False" Style="{StaticResource Button.Dialog.Confirm}" Content="Apply" Click="OnApplyClick"/>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
