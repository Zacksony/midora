<Window x:Class="Midora.Desktop.ApplicationPreferencesDialog"
        FontFamily="{StaticResource Font.UI}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="Application Preferences" Width="760" Height="740" MinWidth="650" MinHeight="620"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Surface.0}" SnapsToDevicePixels="True" UseLayoutRounding="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="58"/></Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseDown">
        <TextBlock Margin="12,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Application Preferences"/>
        <Button Width="46" Height="38" HorizontalAlignment="Right" Style="{StaticResource Button.Caption.Close}" ToolTip="Close" Click="OnCancelClick"><ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/></Button>
      </Grid>
      <TabControl x:Name="PreferencesTabs" Grid.Row="1" Margin="12,10,12,0">
        <TabItem Header="Audio">
          <ScrollViewer Padding="10" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Style="{StaticResource Text.Section}" Text="Playback"/>
              <TextBlock Margin="0,5,0,14" Style="{StaticResource Text.Caption}" Text="These settings apply to every Project and can change only while playback is stopped." TextWrapping="Wrap"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource Text.Overline}" Text="MASTER VOLUME (dB)"/><TextBox x:Name="PlaybackMasterVolumeBox" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Text.Overline}" Text="STOP CURSOR BEHAVIOR"/><ComboBox x:Name="StopCursorBox" Margin="0,5,0,0"/></StackPanel>
                <CheckBox x:Name="PlaybackLimiterBox" Grid.Column="4" Margin="0,22,0,0" VerticalAlignment="Top" Content="Limiter enabled"/>
              </Grid>
              <Border Height="1" Margin="0,18" Background="{StaticResource Brush.Border}"/>
              <TextBlock Style="{StaticResource Text.Section}" Text="Realtime Audio"/>
              <TextBlock Margin="0,5,0,14" Style="{StaticResource Text.Caption}" Text="Changes that affect the audio host rebuild the persistent Worker when settings are applied." TextWrapping="Wrap"/>
              <TextBlock Style="{StaticResource Text.Overline}" Text="PLAYBACK OUTPUT DEVICE"/>
              <ComboBox x:Name="DeviceBox" Margin="0,5,0,0" DisplayMemberPath="DisplayName"/>
              <TextBlock x:Name="DeviceStatusText" Margin="0,5,0,14" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Style="{StaticResource Text.Overline}" Text="RENDER-AHEAD (ms)"/><TextBox x:Name="RenderAheadBox" Margin="0,5,0,0"/><TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="20–2,000"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Text.Overline}" Text="DEVICE REQUEST (ms)"/><TextBox x:Name="DeviceRequestBox" Margin="0,5,0,0"/><TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="5–200"/></StackPanel>
                <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource Text.Overline}" Text="MAX VOICES / CHANNEL"/><TextBox x:Name="VoicesBox" Margin="0,5,0,0"/><TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="1–16,777,216"/></StackPanel>
              </Grid>
              <Border Height="1" Margin="0,18" Background="{StaticResource Brush.Border}"/>
              <TextBlock Style="{StaticResource Text.Section}" Text="Audio Cache"/>
              <TextBlock Margin="0,5,0,14" Style="{StaticResource Text.Caption}" Text="Session and transient recovery data remain runtime state." TextWrapping="Wrap"/>
              <TextBlock Style="{StaticResource Text.Overline}" Text="MAXIMUM REUSABLE CACHE (GiB)"/>
              <TextBox x:Name="CacheQuotaBox" Width="190" Margin="0,5,0,0" HorizontalAlignment="Left"/>
              <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="0 disables reusable audio-cache retention."/>
            </StackPanel>
          </ScrollViewer>
        </TabItem>
        <TabItem Header="SoundFonts">
          <Grid Margin="10">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Text.Caption}" Text="All Projects use the enabled SF2/SFZ files below. Order defines BASSMIDI priority. SFZ requires a target Bank MSB, Bank LSB, and Program." TextWrapping="Wrap"/>
            <StackPanel Grid.Row="1" Margin="0,12,0,8" Orientation="Horizontal"><Button Width="82" Margin="0,0,7,0" Content="Add…" Click="OnAddSoundFontsClick"/><Button Width="82" Margin="0,0,7,0" Content="Remove" Click="OnRemoveSoundFontClick"/><Button Width="72" Margin="0,0,7,0" Content="Up" Click="OnMoveSoundFontUpClick"/><Button Width="72" Content="Down" Click="OnMoveSoundFontDownClick"/><TextBlock x:Name="SoundFontCountText" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"/></StackPanel>
            <ListBox x:Name="SoundFontListBox" Grid.Row="2" SelectionMode="Single" ScrollViewer.CanContentScroll="False" PreviewMouseWheel="OnSoundFontListPreviewMouseWheel">
              <ListBox.ItemTemplate><DataTemplate>
                <Grid Margin="2,5">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <CheckBox VerticalAlignment="Center" IsChecked="{Binding Enabled}"/>
                  <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{Binding FileName}" TextTrimming="CharacterEllipsis"/><TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Path}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/></StackPanel>
                  <StackPanel Grid.Column="4" Width="272"><CheckBox Content="Target mapping" IsChecked="{Binding HasTarget}" IsEnabled="{Binding TargetOptional}"/>
                    <Grid Margin="0,5,0,0" IsEnabled="{Binding HasTarget}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/><ColumnDefinition Width="7"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Style="{StaticResource Text.Overline}" Text="BANK MSB"/><TextBox Margin="0,3,0,0" Text="{Binding BankMsbText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Text.Overline}" Text="BANK LSB"/><TextBox Margin="0,3,0,0" Text="{Binding BankLsbText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                      <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource Text.Overline}" Text="PROGRAM"/><TextBox Margin="0,3,0,0" Text="{Binding ProgramText, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
                    </Grid>
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}"
                               Text="{Binding ResolvedTargetText}" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
          </Grid>
        </TabItem>
        <TabItem Header="Appearance">
          <StackPanel Margin="10"><TextBlock Style="{StaticResource Text.Section}" Text="Appearance"/><TextBlock Margin="0,5,0,14" Style="{StaticResource Text.Caption}" Text="Additional appearance and localization settings will be added here."/><TextBlock Style="{StaticResource Text.Overline}" Text="LANGUAGE"/><ComboBox x:Name="LanguageBox" Width="240" Margin="0,5,0,0" HorizontalAlignment="Left"/><TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Caption}" Text="English is the only language available in this release."/></StackPanel>
        </TabItem>
      </TabControl>
      <Border x:Name="ValidationBorder" Grid.Row="2" Margin="18,8" Padding="9" Background="{StaticResource Brush.Red.Subtle}" BorderBrush="{StaticResource Brush.Red}" BorderThickness="1" CornerRadius="3" Visibility="Collapsed"><TextBlock x:Name="ValidationText" Foreground="{StaticResource Brush.Red.Hover}" TextWrapping="Wrap"/></Border>
      <Border Grid.Row="3" Padding="10" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0"><Grid><Button Width="132" HorizontalAlignment="Left" Content="Restore Defaults" Click="OnRestoreDefaultsClick"/><StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Margin="0,0,7,0" Style="{StaticResource Button.Dialog.Cancel}" Content="Cancel" IsCancel="True" Click="OnCancelClick"/><Button Style="{StaticResource Button.Dialog.Confirm}" Content="Apply" IsDefault="True" Click="OnApplyClick"/></StackPanel></Grid></Border>
    </Grid>
  </Border>
</Window>
