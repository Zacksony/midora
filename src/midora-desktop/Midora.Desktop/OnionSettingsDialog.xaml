<Window x:Class="Midora.Desktop.OnionSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="Onion Skin Settings" FontFamily="{DynamicResource Font.UI}" Width="480" Height="244" MinWidth="420" MinHeight="244"
        Background="{DynamicResource Brush.Surface.0}" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True" PreviewKeyDown="OnDialogKeyDown">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
    <Grid Background="{DynamicResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseDown">
      <TextBlock Margin="12,0,48,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Onion Skin Settings"/>
      <Button HorizontalAlignment="Right" Width="46" Height="36" Style="{DynamicResource Button.Caption.Close}" Click="OnCancel"><ui:FluentIcon Style="{DynamicResource Icon.WindowControl}" Data="{DynamicResource WindowControl.Close}"/></Button>
    </Grid>
    <StackPanel Grid.Row="1" Margin="14,12">
      <TextBlock Text="Adjust the opacity of read-only source notes. Choose sources and enable onion skin from the layer menu." TextWrapping="Wrap" Style="{DynamicResource Text.Muted}"/>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
        <TextBlock VerticalAlignment="Center" Margin="0,0,12,0" Text="Opacity"/>
        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding OpacityPercent}" TickFrequency="1" IsSnapToTickEnabled="True"/>
        <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Text="{Binding OpacityPercent, StringFormat={}{0:0}%}"/>
      </Grid>
    </StackPanel>
    <Border Grid.Row="2" Padding="12,10" Background="{DynamicResource Brush.Surface.1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
      <Grid><Button Content="Help" HorizontalAlignment="Left" Click="OnHelp"/>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Style="{DynamicResource Button.Dialog.Cancel}" Margin="0,0,6,0" Content="Cancel" Click="OnCancel"/><Button Style="{DynamicResource Button.Dialog.Confirm}" Content="OK" Click="OnAccept"/></StackPanel>
      </Grid>
    </Border>
  </Grid></Border>
</Window>
