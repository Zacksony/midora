<Window x:Class="Midora.Desktop.TrackPropertiesDialog"
        FontFamily="{StaticResource Font.UI}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="Track Properties" Width="480" Height="336" MinWidth="440" MinHeight="320"
        MaxHeight="620" ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.Surface.0}" WindowStyle="None"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="58"/>
      </Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
        <TextBlock x:Name="TitleText" Margin="11,0,44,0" VerticalAlignment="Center"
                   FontWeight="SemiBold" Text="Track Properties" TextTrimming="CharacterEllipsis"/>
        <Button Width="46" Height="36" HorizontalAlignment="Right"
                Style="{StaticResource Button.Caption.Close}" Click="OnCancelClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}"
                         Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>
      <ScrollViewer Grid.Row="1" Padding="18,16" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Margin="0,0,0,4" Style="{StaticResource Text.Caption}" Text="NAME"/>
          <TextBox x:Name="NameTextBox" Margin="0,0,0,14"/>
          <CheckBox x:Name="UseInstrumentColorCheckBox" Margin="0,0,0,14"
                    Content="Use Event Instrument color"
                    Click="OnUseInstrumentColorClick"/>
          <TextBlock Margin="0,0,0,4" Style="{StaticResource Text.Caption}" Text="COLOR"/>
          <Button x:Name="SelectColorButton" Height="34" HorizontalContentAlignment="Stretch"
                  Style="{StaticResource Button.Ghost}" Click="OnSelectColorClick">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="18" Height="18" Margin="1,0,10,0" VerticalAlignment="Center"
                      BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1"
                      CornerRadius="2">
                <Rectangle x:Name="ColorSwatch" Margin="2"/>
              </Border>
              <TextBlock x:Name="ColorText" Grid.Column="1" VerticalAlignment="Center"/>
            </Grid>
          </Button>
          <TextBlock x:Name="ColorHintText" Margin="0,6,0,0"
                     Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
          <TextBlock x:Name="ErrorTextBlock" Margin="0,10,0,0"
                     Foreground="{StaticResource Brush.Red.Hover}" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="12,10" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <Button Margin="0,0,6,0" IsCancel="True"
                  Style="{StaticResource Button.Dialog.Cancel}" Content="Cancel"
                  Click="OnCancelClick"/>
          <Button IsDefault="True" Style="{StaticResource Button.Dialog.Confirm}"
                  Content="OK" Click="OnConfirmClick"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
