<Window x:Class="Midora.Desktop.QuantizeSelectionDialog"
        FontFamily="{StaticResource Font.UI}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="Quantize Selection"
        Width="520" Height="315" MinWidth="470" MinHeight="285"
        Background="{StaticResource Brush.Surface.0}" WindowStyle="None"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
        <TextBlock x:Name="TitleText" Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Quantize Selection"/>
        <Button Width="46" Height="36" HorizontalAlignment="Right" Style="{StaticResource Button.Caption.Close}"
                Click="OnCancelClick"><ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/></Button>
      </Grid>
      <StackPanel Grid.Row="1" Margin="16,14">
        <TextBlock Margin="0,0,0,14" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                   Text="Move selected objects to the nearest grid point. Exact halfway values move to the earlier grid point."/>
        <Grid Margin="0,0,0,11">
          <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="Grid"/>
          <ComboBox x:Name="GridBox" Grid.Column="1" DisplayMemberPath="Label"
                    SelectionChanged="OnGridChanged"/>
        </Grid>
        <Grid x:Name="CustomTicksRow" Margin="0,0,0,11" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="48"/></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="Custom Grid"/>
          <TextBox x:Name="CustomTicksBox" Grid.Column="1" Text="1"
                   TextChanged="OnInputChanged"/>
          <TextBlock Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Text="Ticks"/>
        </Grid>
        <Grid x:Name="NoteModeRow">
          <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <TextBlock VerticalAlignment="Center" Text="Note Boundaries"/>
          <ComboBox x:Name="NoteModeBox" Grid.Column="1" SelectedIndex="0"
                    SelectionChanged="OnInputChanged">
            <ComboBoxItem Content="Start Only"/>
            <ComboBoxItem Content="Start and End"/>
          </ComboBox>
        </Grid>
        <TextBlock x:Name="ValidationText" Margin="130,10,0,0" Style="{StaticResource Text.Caption}"
                   Foreground="{StaticResource Brush.Red.Hover}" TextWrapping="Wrap"/>
      </StackPanel>
      <Border Grid.Row="2" Padding="12,10" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <Button Margin="0,0,6,0" IsCancel="True" Style="{StaticResource Button.Dialog.Cancel}"
                  Content="Cancel" Click="OnCancelClick"/>
          <Button IsDefault="True" Style="{StaticResource Button.Dialog.Confirm}"
                  Content="Apply" Click="OnApplyClick"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
