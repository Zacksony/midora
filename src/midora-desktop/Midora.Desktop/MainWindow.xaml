<Window x:Class="Midora.Desktop.MainWindow"
        FontFamily="{StaticResource Font.UI}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Midora.Desktop"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/Midora;component/Assets/midora.ico"
        Width="1440" Height="900" MinWidth="1100" MinHeight="680"
        Background="{StaticResource Brush.Surface.0}"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen" WindowStyle="None"
        SnapsToDevicePixels="True" UseLayoutRounding="True"
        Closing="OnWindowClosing">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <Style x:Key="LaneTabs" TargetType="local:LaneTabHost">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="local:LaneTabHost">
        <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <local:LaneTabHeader x:Name="PART_LaneHeader"/>
          <ContentPresenter Grid.Row="1" x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <local:WorkspaceTabIconConverter x:Key="WorkspaceTabIconConverter"/>
    <Style x:Key="Button.CommandBarText" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
      <Setter Property="Foreground" Value="#F1F3F5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Small}"
                    SnapsToDevicePixels="True">
              <ContentPresenter x:Name="Content"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Surface.4}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Text.Tertiary}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Black}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Red.Dark}"/>
                <Setter TargetName="Content" Property="Margin" Value="0,1,0,-1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="#8A939F"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Text.CommandBarButton"
           TargetType="TextBlock"
           BasedOn="{StaticResource {x:Type TextBlock}}">
      <Setter Property="Foreground" Value="#F1F3F5"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="False">
          <Setter Property="Foreground" Value="#8A939F"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DiagnosticSeverityText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Info}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Warning">
          <Setter Property="Foreground" Value="{StaticResource Brush.Warning}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Error">
          <Setter Property="Foreground" Value="{StaticResource Brush.Red.Hover}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="DiagnosticSeverityBadge" TargetType="Border">
      <Setter Property="Padding" Value="7,2"/>
      <Setter Property="CornerRadius" Value="3"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{StaticResource Brush.Info.Subtle}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Info}"/>
      <Style.Triggers>
        <DataTrigger Binding="{Binding Severity}" Value="Warning">
          <Setter Property="Background" Value="{StaticResource Brush.Warning.Subtle}"/>
          <Setter Property="BorderBrush" Value="{StaticResource Brush.Warning}"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding Severity}" Value="Error">
          <Setter Property="Background" Value="{StaticResource Brush.Red.Subtle}"/>
          <Setter Property="BorderBrush" Value="{StaticResource Brush.Red.Dark}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <ContextMenu x:Key="TimelineContextMenu" x:Shared="False" Opened="OnTimelineContextMenuOpened" Closed="OnTimelineContextMenuClosed">
      <MenuItem Header="Open" Click="OnOpenWorkspaceSelectionClick"/>
      <Separator/>
      <MenuItem Header="Cut" InputGestureText="Ctrl+X" IsEnabled="{Binding PlacementTarget.CanEdit, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Click="OnCutClick"/>
      <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="OnCopyClick"/>
      <MenuItem Header="Paste" InputGestureText="Ctrl+V" IsEnabled="{Binding PlacementTarget.CanEdit, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Click="OnPasteClick"/>
      <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" IsEnabled="{Binding PlacementTarget.CanEdit, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Click="OnDuplicateClick"/>
      <Separator/>
      <MenuItem Header="Delete" InputGestureText="Delete" IsEnabled="{Binding PlacementTarget.CanEdit, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}" Click="OnDeleteWorkspaceSelectionClick"/>
      <Separator/>
      <MenuItem Header="Set Time Range from Object Selection" Click="OnSetTimeRangeFromObjectsClick"/>
      <MenuItem Header="Select Objects in Time Range" Click="OnSelectObjectsInTimeRangeClick"/>
      <MenuItem Header="Clear Time Range" Click="OnClearTimeRangeClick"/>
    </ContextMenu>
    <ContextMenu x:Key="DiagnosticContextMenu" x:Shared="False">
      <MenuItem Header="Go to Source" Click="OnNavigateDiagnosticClick"/>
      <Separator/>
      <MenuItem Header="Copy Message" Click="OnCopyDiagnosticMessageClick"/>
      <MenuItem Header="Copy Code" Click="OnCopyDiagnosticCodeClick"/>
    </ContextMenu>
    <Style x:Key="PanelHeader" TargetType="Border">
      <Setter Property="Height" Value="34" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="Background" Value="{StaticResource Brush.Surface.1}" />
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
    </Style>
    <Style x:Key="EventInstrumentBrowserItemStyle" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="9,7"/>
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="DropChrome"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
              <Border x:Name="Chrome"
                      Padding="{TemplateBinding Padding}"
                      Background="Transparent"
                      CornerRadius="3">
                <ContentPresenter/>
              </Border>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Surface.3}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Red.Subtle}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PropertyLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="Margin" Value="0,0,0,4" />
    </Style>
    <Style x:Key="SingleLineWorkspaceTabs" TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Background="{StaticResource Brush.Surface.1}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="32"/></Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                  <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1"/>
                </ScrollViewer>
                <Button Grid.Column="1" Width="28" Height="28" Margin="2" Padding="0" Style="{StaticResource Button.Icon}"
                        ToolTip="Workspace list" Click="OnWorkspaceTabListClick">
                  <TextBlock FontSize="14" Text="▾"/>
                </Button>
              </Grid>
              <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                Content="{TemplateBinding SelectedItem}"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="ProjectSettingFieldTemplate">
      <StackPanel Margin="0,0,0,10">
        <TextBlock Style="{StaticResource PropertyLabel}" Text="{Binding Label}"/>
        <Grid>
          <TextBox Tag="{Binding}" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                   LostKeyboardFocus="OnProjectSettingLostKeyboardFocus"
                   KeyDown="OnProjectSettingKeyDown">
            <TextBox.Style>
              <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="IsReadOnly" Value="True"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsEditable}" Value="True"/><Condition Binding="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsReadOnly" Value="False"/></MultiDataTrigger>
                </Style.Triggers>
              </Style>
            </TextBox.Style>
          </TextBox>
          <ComboBox Tag="{Binding}" ItemsSource="{Binding Options}" SelectedItem="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DropDownClosed="OnProjectSettingChoiceDropDownClosed">
            <ComboBox.Style><Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="IsEnabled" Value="False"/><Style.Triggers><DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsChoice}" Value="True"/><Condition Binding="{Binding IsEditable}" Value="True"/><Condition Binding="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/></MultiDataTrigger.Conditions><Setter Property="IsEnabled" Value="True"/></MultiDataTrigger></Style.Triggers></Style></ComboBox.Style>
          </ComboBox>
        </Grid>
      </StackPanel>
    </DataTemplate>
    <Style x:Key="TreeItemStyle" TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
      <Setter Property="Padding" Value="3" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="FocusVisualStyle" Value="{x:Null}" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="IsExpanded" Value="True" />
      <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ToggleButton x:Name="Expander" Width="16" Height="20" Padding="0" Focusable="False" Background="Transparent" BorderThickness="0"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                  <TextBlock Text="›" FontSize="14" Foreground="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType={x:Type ToggleButton}}}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                  </TextBlock>
                </ToggleButton>
                <Border Grid.Column="1" Padding="{TemplateBinding Padding}" Background="Transparent" BorderBrush="Transparent" BorderThickness="0">
                  <ContentPresenter ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                </Border>
              </Grid>
              <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="16,0,0,0"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
              <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="WorkspaceTabItemStyle" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
      <Setter Property="AutomationProperties.Name" Value="{Binding Header}"/>
    </Style>
    <Style x:Key="Button.PrimaryTransport" TargetType="Button" BasedOn="{StaticResource Button.Base}">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="{StaticResource Brush.Red}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Brush.Red}"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Padding="{TemplateBinding Padding}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource Radius.Small}">
              <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding IsPlaybackActive}" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Surface.3}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Red}"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}"/>
              </DataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsPlaybackActive}" Value="False"/>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Red.Hover}"/>
              </MultiDataTrigger>
              <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                  <Condition Binding="{Binding IsPlaybackActive}" Value="True"/>
                  <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Surface.4}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Red.Hover}"/>
              </MultiDataTrigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Black}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Red.Dark}"/>
                <Setter TargetName="Content" Property="Margin" Value="0,1,0,-1"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Chrome" Property="Background" Value="Transparent"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="RenderedSurfaceHost" TargetType="GroupBox">
      <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/>
      <Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="VerticalContentAlignment" Value="Stretch"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupBox"><ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <HierarchicalDataTemplate DataType="{x:Type local:ProjectTreeNode}" ItemsSource="{Binding Children}">
      <Border x:Name="TreeChrome" Padding="4,3" Background="Transparent" CornerRadius="3">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="TreeTitle" Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis"/>
          <TextBox x:Name="TreeRename" Margin="-3,-2" Padding="3,1" Visibility="Collapsed"
                   Grid.ColumnSpan="3"
                   Text="{Binding EditText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                   Loaded="OnTreeRenameLoaded" LostKeyboardFocus="OnTreeRenameLostKeyboardFocus"
                   KeyDown="OnTreeRenameKeyDown"/>
        </Grid>
      </Border>
      <HierarchicalDataTemplate.Triggers>
        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=IsSelected}" Value="True">
          <Setter TargetName="TreeChrome" Property="Background" Value="{StaticResource Brush.Red.Subtle}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding IsRenaming}" Value="True">
          <Setter TargetName="TreeTitle" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="TreeRename" Property="Visibility" Value="Visible"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsDamaged}" Value="True">
          <Setter TargetName="TreeTitle" Property="Foreground" Value="{StaticResource Brush.Red.Hover}"/>
        </DataTrigger>
      </HierarchicalDataTemplate.Triggers>
    </HierarchicalDataTemplate>

    <DataTemplate DataType="{x:Type local:AllTracksWorkspaceViewModel}"><local:AllTracksView PlaybackCursorRequested="OnTimelineRulerClicked"/></DataTemplate>
    <DataTemplate DataType="{x:Type local:TimelineWorkspaceViewModel}">
      <Grid Background="{StaticResource Brush.Surface.0}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ObjectList.ColumnWidth, Mode=TwoWay}"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="38" />
          <RowDefinition Height="*" />
          <RowDefinition Height="5" />
          <RowDefinition Height="{Binding BottomEditorRowHeight, Mode=TwoWay}"
                         MinHeight="{Binding BottomEditorMinimumHeight}"
                         MaxHeight="{Binding BottomEditorMaximumHeight}" />
        </Grid.RowDefinitions>
        <Border Grid.ColumnSpan="3" Style="{StaticResource PanelHeader}">
          <Grid>
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Header}">
                <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><DataTrigger Binding="{Binding IsArrangement}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsSegment}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger><DataTrigger Binding="{Binding IsConductor}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
              <TextBlock VerticalAlignment="Center" Text="{Binding Context}">
                <TextBlock.Style>
                  <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                    <Setter Property="Margin" Value="9,0,0,0"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsArrangement}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger>
                      <DataTrigger Binding="{Binding IsSegment}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger>
                      <DataTrigger Binding="{Binding IsConductor}" Value="True"><Setter Property="Margin" Value="0"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
              <StackPanel Orientation="Horizontal">
                <StackPanel.Style>
                  <Style TargetType="StackPanel">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding PointerPositionText, ElementName=Timeline}" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                      <DataTrigger Binding="{Binding IsConductor}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </StackPanel.Style>
                <TextBlock MinWidth="82" Margin="0,0,7,0" VerticalAlignment="Center" TextAlignment="Right" Foreground="{StaticResource Brush.Text.Primary}" Style="{StaticResource Text.Mono}" Text="{Binding PointerPositionText, ElementName=Timeline}"/>
                <Border Width="1" Height="18" Margin="0,0,7,0" Background="{StaticResource Brush.Border}"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSegment}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <ToggleButton Margin="0,0,4,0" Padding="7,0" Content="List" ToolTip="Show object list" IsChecked="{Binding ObjectList.IsVisible, Mode=TwoWay}"/>
                <ToggleButton Margin="0,0,4,0" Padding="7,0" Content="Lanes" IsChecked="{Binding IsLowerEditorVisible, Mode=TwoWay}"/>
                <Border Width="1" Height="18" Margin="3,0,7,0" Background="{StaticResource Brush.Border}"/>
              </StackPanel>
              <ToggleButton Width="44" Margin="0,0,4,0" Padding="0" Content="Grid" IsChecked="{Binding EditorSettings.GridVisible, Mode=TwoWay}" ToolTip="Show subdivision grid"/>
              <Border Width="1" Height="18" Margin="3,0,7,0" Background="{StaticResource Brush.Border}"/>
              <ToggleButton Margin="0,0,4,0" Content="Snap" ToolTip="Enable/Disable Snap (A)" IsChecked="{Binding EditorSettings.SnapEnabled, Mode=TwoWay}"/>
              <ComboBox Width="92" Height="24" Margin="0,0,4,0" IsEditable="True"
                        ItemsSource="{Binding EditorSettings.SubdivisionPresets}"
                        Text="{Binding EditorSettings.OperationSubdivisionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Tag="Operation" LostKeyboardFocus="OnSubdivisionComboBoxLostKeyboardFocus"
                        ToolTip="Operation subdivision; enter any positive n in 1/n"/>
              <Border Width="1" Height="18" Margin="3,0,7,0" Background="{StaticResource Brush.Border}"/>
              <TextBlock Margin="3,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="Length"/>
              <TextBox Width="58" Height="24" Margin="0,0,4,0" Padding="5,0" Text="{Binding EditorSettings.DefaultLengthTicks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Default creation length in ticks"/>
              <StackPanel Margin="0,0,4,0" Orientation="Horizontal">
                <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSegment}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                <TextBlock Margin="3,0" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="Vel"/>
                <TextBox Width="42" Height="24" Padding="5,0" Text="{Binding EditorSettings.DefaultVelocity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Default note velocity (1–127)"/>
              </StackPanel>
              <Border Width="1" Height="18" Margin="3,0,7,0" Background="{StaticResource Brush.Border}"/>
              <Button Style="{StaticResource Button.TimelineIcon}" ToolTip="Zoom out" Tag="Out" Click="OnTimelineZoomClick"><ui:FluentIcon Width="13" Height="13" Data="{StaticResource Fluent.ZoomOut20Regular}"/></Button>
              <Button Style="{StaticResource Button.TimelineIcon}" ToolTip="Zoom in" Tag="In" Click="OnTimelineZoomClick"><ui:FluentIcon Width="13" Height="13" Data="{StaticResource Fluent.ZoomIn20Regular}"/></Button>
              <Button Margin="0,0,6,0" ToolTip="Onion skin" Tag="{Binding IsOnionEnabled}" IsEnabled="{Binding CanConfigureOnion}" Click="OnOnionMenuClick">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.TimelineOption}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsSegment}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                <ui:FluentIcon Width="13" Height="13" Data="{StaticResource Fluent.LayerDiagonal20Regular}"/>
              </Button>
              <Button Margin="0,0,6,0" ToolTip="All Tracks" Click="OnOpenAllTracksClick">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.TimelineIcon}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsArrangement}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style>
                <ui:FluentIcon Width="13" Height="13" Data="{StaticResource Fluent.LayerDiagonal20Regular}"/>
              </Button>
              <Border Width="1" Height="18" Margin="0,0,7,0" Background="{StaticResource Brush.Border}"/>
