      <Border Grid.Row="3" Padding="10" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Select a diagnostic to inspect its details.">
            <TextBlock.Style>
              <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedItem, ElementName=DiagnosticList}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Grid DataContext="{Binding SelectedItem, ElementName=DiagnosticList}">
            <Grid.Style>
              <Style TargetType="Grid">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Grid.Style>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border VerticalAlignment="Center" Style="{StaticResource DiagnosticSeverityBadge}">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource DiagnosticSeverityText}" Text="{Binding Severity}"/>
              </Border>
              <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Mono}" FontWeight="SemiBold" Text="{Binding Code}"/>
              <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding Category}"/>
                <Border Width="1" Height="12" Margin="9,0" VerticalAlignment="Center" Background="{StaticResource Brush.Border.Strong}"/>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding Status}"/>
                <Button Height="26" Margin="14,0,0,0" Padding="10,0" VerticalAlignment="Center" Content="Go to Source" Click="OnNavigateDiagnosticClick"/>
              </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="0,9,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
              <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" Text="MESSAGE"/>
                <ScrollViewer Grid.Row="1" Margin="0,4,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
                </ScrollViewer>
              </Grid>
              <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Tertiary}" Text="SOURCE"/>
                <ScrollViewer Grid.Row="1" Margin="0,4,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                  <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Source}" TextWrapping="Wrap"/>
                </ScrollViewer>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </Border>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="WindowFrame">
    <Border.Style>
      <Style TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}"/><Setter Property="BorderThickness" Value="1"/>
        <Style.Triggers><DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized"><Setter Property="BorderThickness" Value="0"/></DataTrigger></Style.Triggers>
      </Style>
    </Border.Style>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/><RowDefinition Height="46"/>
        <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="25"/>
      </Grid.RowDefinitions>

      <Grid Grid.Row="0" Background="{StaticResource Brush.Black}"
            MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown" MouseRightButtonUp="OnTitleBarMouseRightButtonUp">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid Margin="12,0,0,0" VerticalAlignment="Center">
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Image Grid.Column="0" Width="20" Height="20" Margin="0,0,5,0"
                 Source="pack://application:,,,/Midora;component/Assets/midora-note-transparent-256x256.png"
                 Stretch="Uniform" SnapsToDevicePixels="True"
                 RenderOptions.BitmapScalingMode="HighQuality"/>
          <Menu x:Name="MainMenu" Grid.Column="1" Height="29" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Menu.ItemContainerStyle><Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}"><Setter Property="VerticalAlignment" Value="Center"/></Style></Menu.ItemContainerStyle>
            <MenuItem Header="File"><MenuItem Header="New Project…" InputGestureText="Ctrl+N" Click="OnNewProjectClick"/><MenuItem Header="Open Project…" InputGestureText="Ctrl+O" Click="OnOpenProjectClick"/><MenuItem Header="Open MIDI as New Project…" Click="OnOpenMidiAsNewProjectClick"/><Separator/><MenuItem Header="Save Project" InputGestureText="Ctrl+S" IsEnabled="{Binding CanSaveProject}" Click="OnSaveProjectClick"/><MenuItem Header="Save Copy…" IsEnabled="{Binding CanSaveProject}" Click="OnSaveCopyClick"/><Separator/><MenuItem Header="Close Project" IsEnabled="{Binding HasProject}" Click="OnCloseProjectClick"/><MenuItem Header="Exit" Click="OnExitClick"/></MenuItem>
            <MenuItem Header="Edit"><MenuItem Header="Undo" InputGestureText="Ctrl+Z" IsEnabled="{Binding CanEditProject}" Click="OnUndoClick"/><MenuItem Header="Redo" InputGestureText="Ctrl+Y" IsEnabled="{Binding CanEditProject}" Click="OnRedoClick"/><Separator/><MenuItem Header="Cut" InputGestureText="Ctrl+X" IsEnabled="{Binding CanEditProject}" Click="OnCutClick"/><MenuItem Header="Copy" InputGestureText="Ctrl+C" IsEnabled="{Binding HasProject}" Click="OnCopyClick"/><MenuItem Header="Paste" InputGestureText="Ctrl+V" IsEnabled="{Binding CanEditProject}" Click="OnPasteClick"/><MenuItem Header="Select All" InputGestureText="Ctrl+A" IsEnabled="{Binding HasProject}" Click="OnSelectAllClick"/><MenuItem Header="Duplicate Selection" InputGestureText="Ctrl+D" IsEnabled="{Binding CanEditProject}" Click="OnDuplicateClick"/></MenuItem>
            <MenuItem Header="View"><MenuItem Header="Arrangement" IsEnabled="{Binding HasProject}" Click="OnOpenArrangementClick"/><MenuItem Header="Diagnostics" IsEnabled="{Binding HasProject}" Click="OnOpenDiagnosticsClick"/><Separator/><MenuItem x:Name="ProjectPanelMenuItem" Header="Project Panel" Visibility="Collapsed" IsCheckable="True" Click="OnToggleProjectPanelClick"/><MenuItem x:Name="SnapMenuItem" Header="Snap to Grid" IsCheckable="True" Click="OnToggleSnapClick"/><MenuItem x:Name="FollowPlaybackMenuItem" Header="Follow Playback" IsCheckable="True" Click="OnToggleFollowPlaybackClick"/><Separator/><MenuItem Header="Reset Layout" Click="OnResetLayoutClick"/><MenuItem Header="Reset Editor View Preferences" Click="OnResetEditorPreferencesClick"/><MenuItem Header="Reset All UI Preferences…" Click="OnResetAllUiPreferencesClick"/></MenuItem>
            <MenuItem Header="Project" IsEnabled="{Binding HasProject}"><MenuItem Header="New Event Instrument" IsEnabled="{Binding CanEditProject}" Click="OnNewInstrumentClick"/><Separator/><MenuItem Header="New Logical Track" IsEnabled="{Binding CanEditProject}" Click="OnNewTrackClick"/><MenuItem Header="New Logical Track with Instrument…" IsEnabled="{Binding CanEditProject}" Click="OnNewTrackWithInstrumentClick"/><MenuItem Header="New Raw MIDI Track…" IsEnabled="{Binding CanEditProject}" Click="OnNewRawMidiTrackClick"/><Separator/><MenuItem Header="Project Settings" Click="OnOpenSettingsClick"/></MenuItem>
            <MenuItem Header="Playback"><MenuItem Header="Play" InputGestureText="Space" IsEnabled="{Binding CanPlayback}" Click="OnPlayClick"/><MenuItem Header="Stop" InputGestureText="Space" IsEnabled="{Binding IsPlaybackActive}" Click="OnStopClick"/><Separator/><MenuItem Header="Reset Playback Engine" Click="OnResetPlaybackClick"/></MenuItem>
            <MenuItem Header="Compile" IsEnabled="{Binding CanRunProjectTask}"><MenuItem Header="Compile Project" Click="OnCompileClick"/></MenuItem>
            <MenuItem Header="Export" IsEnabled="{Binding CanRunProjectTask}"><MenuItem Header="MIDI Export…" Click="OnMidiExportClick"/><MenuItem Header="Audio Export…" Click="OnAudioRenderClick"/></MenuItem>
            <MenuItem Header="Application"><MenuItem Header="Application Preferences…" IsEnabled="{Binding CanStartForegroundTask}" Click="OnApplicationPreferencesClick"/><MenuItem Header="Instrument Catalogs…" Click="OnInstrumentCatalogsClick"/><Separator/><MenuItem Header="About Midora" InputGestureText="F12" Click="OnAboutClick"/></MenuItem>
          </Menu>
          <Border x:Name="TitleBarProjectNameFrame" Grid.Column="2" Margin="8,0,0,0"
                  HorizontalAlignment="Left" VerticalAlignment="Center" Background="Transparent">
            <Grid>
              <Border Background="Transparent" BorderBrush="{StaticResource Brush.Border}"
                      BorderThickness="1" CornerRadius="3">
                <Border.RenderTransform><TranslateTransform Y="1"/></Border.RenderTransform>
              </Border>
              <TextBlock Margin="8,2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"
                         Foreground="{StaticResource Brush.Text.Tertiary}"
                         Text="{Binding TitleBarProjectDisplayName}" TextTrimming="CharacterEllipsis">
                <TextBlock.RenderTransform><TranslateTransform Y="1"/></TextBlock.RenderTransform>
              </TextBlock>
            </Grid>
          </Border>
        </Grid>
        <StackPanel Grid.Column="1" shell:WindowChrome.IsHitTestVisibleInChrome="True" Orientation="Horizontal">
          <Button Style="{StaticResource Button.Caption}" ToolTip="Minimize" Click="OnMinimizeClick"><ui:FluentIcon Style="{StaticResource Icon.WindowControl.Minimize}" Data="{StaticResource WindowControl.Minimize}"/></Button>
          <Button Style="{StaticResource Button.Caption}" ToolTip="Maximize or restore" Click="OnMaximizeClick"><ui:FluentIcon x:Name="MaximizeGlyph" Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Maximize}"/></Button>
          <Button Style="{StaticResource Button.Caption.Close}" ToolTip="Close" Click="OnCloseClick"><ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/></Button>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Padding="9,0" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Button Style="{StaticResource Button.Icon}" ToolTip="Back" Click="OnNavigateBackClick" IsEnabled="{Binding CanNavigateBack}"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.ChevronLeft20Regular}"/></Button>
            <Button Margin="3,0,0,0" Style="{StaticResource Button.Icon}" ToolTip="Forward" Click="OnNavigateForwardClick" IsEnabled="{Binding CanNavigateForward}"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.ChevronRight20Regular}"/></Button>
            <Border Width="1" Height="18" Margin="7,0" Background="{StaticResource Brush.Border}"/>
            <Button Style="{StaticResource Button.Icon}" ToolTip="New Project" Click="OnNewProjectClick"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.Document20Regular}"/></Button>
            <Button Margin="3,0,0,0" Style="{StaticResource Button.Icon}" ToolTip="Open Project" Click="OnOpenProjectClick"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.Folder20Regular}"/></Button>
            <Button Margin="3,0,0,0" Style="{StaticResource Button.Icon}" ToolTip="Project Settings" IsEnabled="{Binding HasProject}" Click="OnOpenSettingsClick"><ui:FluentIcon Style="{StaticResource Icon.DesignCanvas20At16}" Tag="Emphasized" Data="{StaticResource Fluent.Settings20Regular}"/></Button>
            <Button Margin="3,0,0,0" Style="{StaticResource Button.Icon}" ToolTip="Save Project" Click="OnSaveProjectClick" IsEnabled="{Binding CanSaveProject}"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.Save20Regular}"/></Button>
            <Border Width="1" Height="18" Margin="7,0" Background="{StaticResource Brush.Border}"/>
            <Button Style="{StaticResource Button.Icon}" ToolTip="Undo" IsEnabled="{Binding HasProject}" Click="OnUndoClick"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.ArrowUndo20Regular}"/></Button>
            <Button Margin="3,0,0,0" Style="{StaticResource Button.Icon}" ToolTip="Redo" IsEnabled="{Binding HasProject}" Click="OnRedoClick"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.ArrowRedo20Regular}"/></Button>
            <Border Width="1" Height="18" Margin="7,0" Background="{StaticResource Brush.Border}"/>
            <Button Style="{StaticResource Button.Icon}" ToolTip="Application Preferences" IsEnabled="{Binding CanStartForegroundTask}" Click="OnApplicationPreferencesClick"><ui:FluentIcon Style="{StaticResource Icon.DesignCanvas20At16}" Tag="Emphasized" Data="{StaticResource Fluent.WrenchScrewdriver20Regular}"/></Button>
          </StackPanel>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
            <Button Width="34" Height="32" Style="{StaticResource Button.Icon}" ToolTip="Reset Playback Engine" IsEnabled="{Binding HasProject}" Click="OnResetPlaybackClick"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.Flash20Filled}"/></Button>
            <Button x:Name="PrimaryTransportButton" Width="34" Height="32" Margin="4,0" Style="{StaticResource Button.PrimaryTransport}"
                    AutomationProperties.Name="{Binding PrimaryTransportAction}"
                    ToolTip="{Binding PrimaryTransportToolTip}"
                    IsEnabled="{Binding CanTogglePlayback}" Click="OnPrimaryTransportClick">
              <Grid>
                <ui:FluentIcon Width="14" Height="14" Margin="1,0,0,0"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               Data="{StaticResource Fluent.Play20Filled}">
                  <ui:FluentIcon.Style><Style TargetType="ui:FluentIcon" BasedOn="{StaticResource Icon.CommandBar}"><Style.Triggers><DataTrigger Binding="{Binding IsPlaybackActive}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ui:FluentIcon.Style>
                </ui:FluentIcon>
                <ui:FluentIcon Width="14" Height="14"
                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                               Data="{StaticResource Fluent.Stop20Filled}">
                  <ui:FluentIcon.Style><Style TargetType="ui:FluentIcon" BasedOn="{StaticResource Icon.CommandBar}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsPlaybackActive}" Value="True"/><Condition Binding="{Binding IsBuffering}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></ui:FluentIcon.Style>
                </ui:FluentIcon>
                <Ellipse Width="15" Height="15" StrokeThickness="2" StrokeDashArray="1.7 1.7"
                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                         RenderTransformOrigin="0.5,0.5">
                  <Ellipse.RenderTransform><RotateTransform/></Ellipse.RenderTransform>
                  <Ellipse.Style>
                    <Style TargetType="Ellipse">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBuffering}" Value="True">
                          <Setter Property="Visibility" Value="Visible"/>
                          <DataTrigger.EnterActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.75" RepeatBehavior="Forever"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </DataTrigger.EnterActions>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Ellipse.Style>
                </Ellipse>
              </Grid>
            </Button>
            <ToggleButton Width="34" Height="32" Padding="0" ToolTip="Loop Time Range" IsEnabled="{Binding HasProject}" IsChecked="{Binding IsLoopEnabled, Mode=OneWay}" Click="OnLoopClick"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.RepeatAll20Regular}"/></ToggleButton>
            <ToggleButton x:Name="FollowPlaybackToggleButton" Width="34" Height="32" Margin="4,0,0,0" Padding="0" ToolTip="Follow Playback" IsEnabled="{Binding HasProject}" Click="OnFollowPlaybackToggleClick"><ui:FluentIcon Style="{StaticResource Icon.CommandBar}" Data="{StaticResource Fluent.ArrowRight20Filled}"/></ToggleButton>
            <Border Height="32" Margin="9,0,0,0" Padding="9,0" Background="{StaticResource Brush.Surface.0}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3"><StackPanel VerticalAlignment="Center" Orientation="Horizontal"><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" Style="{StaticResource Text.Mono}" Text="{Binding PositionText}"/><Border Width="1" Height="14" Margin="8,0" Background="{StaticResource Brush.Border.Strong}"/><TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{StaticResource Brush.Text.Primary}" Style="{StaticResource Text.Mono}" Text="{Binding TempoText}"/></StackPanel></Border>
          </StackPanel>
          <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
            <Button Margin="0,0,4,0" Style="{StaticResource Button.CommandBarText}" AutomationProperties.Name="Compile" Click="OnCompileClick" IsEnabled="{Binding CanRunProjectTask}"><TextBlock Style="{StaticResource Text.CommandBarButton}" Text="Compile"/></Button>
            <Button Margin="0,0,4,0" Style="{StaticResource Button.CommandBarText}" AutomationProperties.Name="MIDI Export" Click="OnMidiExportClick" IsEnabled="{Binding CanRunProjectTask}"><TextBlock Style="{StaticResource Text.CommandBarButton}" Text="MIDI Export"/></Button>
            <Button Style="{StaticResource Button.CommandBarText}" AutomationProperties.Name="Audio Export" Click="OnAudioRenderClick" IsEnabled="{Binding CanRunProjectTask}"><TextBlock Style="{StaticResource Text.CommandBarButton}" Text="Audio Export"/></Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="2" Padding="10,6" Background="{StaticResource Brush.Red.Subtle}" BorderBrush="{StaticResource Brush.Red.Dark}" BorderThickness="0,0,0,1">
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasNotice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid><TextBlock Margin="0,0,34,0" VerticalAlignment="Center" Text="{Binding Notice}" TextWrapping="Wrap"/><Button Width="26" Height="24" HorizontalAlignment="Right" Padding="0" Style="{StaticResource Button.Ghost}" ToolTip="Dismiss notice" Click="OnDismissNoticeClick"><ui:FluentIcon Width="12" Height="12" Data="{StaticResource Fluent.Dismiss20Regular}"/></Button></Grid>
      </Border>

      <Grid Grid.Row="3">
        <Grid.ColumnDefinitions><ColumnDefinition x:Name="ProjectPanelColumn" Width="0" MinWidth="0"/><ColumnDefinition x:Name="ProjectSplitterColumn" Width="0"/><ColumnDefinition Width="*" MinWidth="500"/></Grid.ColumnDefinitions>
        <Grid x:Name="ProjectPanelGrid" Visibility="Collapsed" Background="{StaticResource Brush.Surface.1}">
          <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource PanelHeader}"><Grid><TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Project"/><ToggleButton x:Name="NewProjectItemButton" Width="26" Height="24" HorizontalAlignment="Right" Padding="0" AutomationProperties.Name="New Project item" ToolTip="New Project item" IsChecked="{Binding IsOpen, ElementName=NewProjectItemPopup, Mode=TwoWay}"><ui:FluentIcon Width="14" Height="14" Data="{StaticResource Fluent.Add20Regular}"/></ToggleButton><Popup x:Name="NewProjectItemPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=NewProjectItemButton}" StaysOpen="False" AllowsTransparency="True"><Border MinWidth="230" Padding="4" Background="{StaticResource Brush.Surface.2}" BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="{StaticResource Radius.Medium}"><StackPanel><StackPanel.Resources><Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}"><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="12,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="BorderThickness" Value="0"/></Style></StackPanel.Resources><Button Content="New Logical Track" Click="OnNewTrackClick"/><Button Content="New Event Instrument" Click="OnNewInstrumentClick"/></StackPanel></Border></Popup></Grid></Border>
          <TextBox Grid.Row="1" Margin="7,7,7,3" ToolTip="Filter Event Instruments, folders, Logical Tracks, and last known instrument names" Text="{Binding ProjectTreeSearchText, UpdateSourceTrigger=PropertyChanged}"/>
          <TreeView x:Name="ProjectTree" Grid.Row="2" Padding="6" Background="Transparent" BorderThickness="0"
                    AutomationProperties.Name="Project navigation"
                    ItemsSource="{Binding ProjectTree}" ItemContainerStyle="{StaticResource TreeItemStyle}"
                    AllowDrop="True"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    MouseDoubleClick="OnProjectTreeDoubleClick" PreviewKeyDown="OnProjectTreeKeyDown"
                    PreviewMouseLeftButtonDown="OnProjectTreeLeftButtonDown"
                    PreviewMouseMove="OnProjectTreeMouseMove"
                     DragOver="OnProjectTreeDragOver" Drop="OnProjectTreeDrop"
                     PreviewMouseRightButtonDown="OnProjectTreeRightButtonDown">
            <TreeView.ContextMenu>
              <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" IsEnabled="{Binding CanUseContextMenus}" Opened="OnProjectTreeContextMenuOpened">
                <MenuItem Header="Open" Click="OnTreeOpenClick"/>
                <MenuItem Header="Rename" InputGestureText="F2" Click="OnTreeRenameClick"/>
                <MenuItem Header="Bind Event Instrument…" Click="OnTreeBindInstrumentClick"/>
                <Separator/>
                <MenuItem Header="Move Up" Click="OnTreeMoveUpClick"/>
                <MenuItem Header="Move Down" Click="OnTreeMoveDownClick"/>
                <Separator/>
                <MenuItem Header="Delete…" Click="OnTreeDeleteClick"/>
              </ContextMenu>
            </TreeView.ContextMenu>
          </TreeView>
        </Grid>
        <GridSplitter x:Name="ProjectPanelSplitter" Grid.Column="1" Visibility="Collapsed" HorizontalAlignment="Stretch"/>
        <Grid Grid.Column="2">
          <TabControl x:Name="WorkspaceTabs" Style="{StaticResource SingleLineWorkspaceTabs}" ItemContainerStyle="{StaticResource WorkspaceTabItemStyle}" FocusVisualStyle="{x:Null}" AutomationProperties.Name="Workspaces" Visibility="{Binding HasProject, Converter={StaticResource BooleanToVisibility}}" ItemsSource="{Binding Workspaces}" SelectedItem="{Binding ActiveWorkspace, Mode=TwoWay}"
                      SelectionChanged="OnWorkspaceTabsSelectionChanged"
                      AllowDrop="True" PreviewMouseLeftButtonDown="OnWorkspaceTabsLeftButtonDown" PreviewMouseMove="OnWorkspaceTabsMouseMove" DragOver="OnWorkspaceTabsDragOver" Drop="OnWorkspaceTabsDrop">
            <TabControl.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><StackPanel.ContextMenu><ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"><MenuItem Header="Close" IsEnabled="{Binding CanClose}" Click="OnCloseWorkspaceClick"/><MenuItem Header="Close Other Workspaces" Click="OnCloseOtherWorkspacesClick"/></ContextMenu></StackPanel.ContextMenu><ui:FluentIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Style="{StaticResource Icon.Stepper}" Data="{Binding TabIconKind, Converter={StaticResource WorkspaceTabIconConverter}}"/><TextBlock VerticalAlignment="Center" Text="{Binding Header}"/><Button Width="20" Height="20" Margin="7,0,0,0" Padding="0" Style="{StaticResource Button.Ghost}" ToolTip="Close Workspace" Visibility="{Binding CanClose, Converter={StaticResource BooleanToVisibility}}" Click="OnCloseWorkspaceClick"><ui:FluentIcon Width="10" Height="10" Data="{StaticResource Fluent.Dismiss20Regular}"/></Button></StackPanel></DataTemplate></TabControl.ItemTemplate>
          </TabControl>
          <Border x:Name="EmptyState" Margin="48" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
            <StackPanel Width="460">
              <TextBlock Margin="0,0,0,18" HorizontalAlignment="Stretch" FontSize="24" FontWeight="Light"
                         Text="{Binding WelcomeHeadline}" TextAlignment="Center" TextTrimming="None"
                         TextWrapping="Wrap" RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform><TranslateTransform Y="-18"/></TextBlock.RenderTransform>
              </TextBlock>
              <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <Button Margin="0,0,7,0" Style="{StaticResource Button.Primary}" Content="New Project" Click="OnNewProjectClick"/>
                <Button Margin="0,0,7,0" Content="Open Project" Click="OnOpenProjectClick"/>
                <Button Content="Open MIDI as New Project" Click="OnOpenMidiAsNewProjectClick"/>
              </StackPanel>
            </StackPanel>
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasProject}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
          </Border>
        </Grid>
      </Grid>

      <Border Grid.Row="4" Padding="9,0" Background="{StaticResource Brush.Black}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <Grid>
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
            <Ellipse Width="6" Height="6" Margin="0,0,6,0" ToolTip="{Binding IssueSummary}">
              <Ellipse.Style>
                <Style TargetType="Ellipse">
                  <Setter Property="Fill" Value="{StaticResource Brush.Success}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding HasWarnings}" Value="True"><Setter Property="Fill" Value="{StaticResource Brush.Warning}"/></DataTrigger>
                    <DataTrigger Binding="{Binding HasErrors}" Value="True"><Setter Property="Fill" Value="{StaticResource Brush.Red}"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Ellipse.Style>
            </Ellipse>
            <TextBlock Background="Transparent"
                       Cursor="Hand"
                       Text="{Binding IssueSummary}"
                       ToolTip="Open Diagnostics"
                       AutomationProperties.Name="Open Diagnostics"
                       MouseLeftButtonUp="OnDiagnosticSummaryMouseLeftButtonUp">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Border Width="1" Height="11" Margin="9,0" Background="{StaticResource Brush.Border}"/>
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding CompileState}"/>
            <Border Width="1" Height="11" Margin="9,0" Background="{StaticResource Brush.Border}"/>
            <TextBlock Text="{Binding SoundFontState}" IsEnabled="{Binding CanStartForegroundTask}"
                       ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Open SoundFont Settings"
                       MouseLeftButtonUp="OnSoundFontStatusMouseLeftButtonUp">
              <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                  <Setter Property="Cursor" Value="Hand"/>
                  <Setter Property="ToolTip" Value="Open SoundFont Settings"/>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                      <Setter Property="Cursor" Value="Arrow"/>
                      <Setter Property="ToolTip" Value="Stop playback and finish the current task before changing SoundFonts."/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
            <Border Width="1" Height="11" Margin="9,0" Background="{StaticResource Brush.Border}"/>
            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ProjectState}"/>
            <Border Width="1" Height="11" Margin="9,0" Background="{StaticResource Brush.Border}"/>
            <TextBlock Text="{Binding PlaybackStatusText}">
              <TextBlock.Style>
                 <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                   <Style.Triggers>
                     <DataTrigger Binding="{Binding IsPlaybackActive}" Value="True">
                       <Setter Property="Foreground" Value="{StaticResource Brush.Success}"/>
                     </DataTrigger>
                     <DataTrigger Binding="{Binding IsBuffering}" Value="True">
                      <Setter Property="Foreground" Value="#FFFFC400"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </StackPanel>
          <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
            <TextBlock MaxWidth="520" VerticalAlignment="Center" Text="{Binding StatusMessage}" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}"><Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}"/><Style.Triggers><DataTrigger Binding="{Binding StatusMessageIsError}" Value="True"><Setter Property="Foreground" Value="{StaticResource Brush.Red.Hover}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Button Height="20" Margin="7,0,0,0" Padding="6,0" Content="View Full Message" Click="OnStatusMessageDetailsClick"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasStatusMessage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            <Button Height="20" Margin="7,0,0,0" Padding="6,0" Content="Dismiss" Click="OnDismissStatusMessageClick"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Button.Ghost}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasStatusMessage}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
          </StackPanel>
        </Grid>
      </Border>

      <Border x:Name="TaskLockOverlay" Grid.RowSpan="6" Panel.ZIndex="1000" Focusable="True"
              Background="#D9101216" IsHitTestVisible="True">
        <Border.Style>
          <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding IsMainWindowTaskLocked}" Value="True">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </Border.Style>
        <Border Width="460" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border.Strong}"
                BorderThickness="1" CornerRadius="4">
          <StackPanel DataContext="{Binding ActiveForegroundTask}">
            <TextBlock Style="{StaticResource Text.Overline}" Text="MIDORA TASK"/>
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" Text="{Binding Name}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Detail}" TextWrapping="Wrap"/>
            <ProgressBar Height="7" Margin="0,18,0,0" Minimum="0" Maximum="1"
                         Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}">
              <ProgressBar.Style>
                <Style TargetType="ProgressBar" BasedOn="{StaticResource TaskProgressBar}">
                  <Style.Triggers><DataTrigger Binding="{Binding Progress}" Value="{x:Null}"><Setter Property="IsIndeterminate" Value="True"/></DataTrigger></Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>
            <Grid Margin="0,16,0,0">
              <Grid.Style>
                <Style TargetType="Grid">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding CanCancel}" Value="False">
                      <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Button x:Name="TaskLockCancelButton" MinWidth="92" HorizontalAlignment="Right" Content="Cancel"
                      IsEnabled="{Binding CanRequestCancel}" Tag="{Binding}" Click="OnCancelTaskClick"/>
            </Grid>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</Window>
