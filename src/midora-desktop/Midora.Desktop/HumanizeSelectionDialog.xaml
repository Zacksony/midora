<Window x:Class="Midora.Desktop.HumanizeSelectionDialog"
        FontFamily="{StaticResource Font.UI}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="Humanize Notes"
        Width="650" Height="485" MinWidth="590" MinHeight="440"
        Background="{StaticResource Brush.Surface.0}" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="36"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="62"/>
      </Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
        <TextBlock Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Humanize Notes"/>
        <Button Width="46" Height="36" HorizontalAlignment="Right"
                Style="{StaticResource Button.Caption.Close}" Click="OnCancelClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>

      <ScrollViewer Grid.Row="1" Padding="16,14" HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Margin="0,0,0,14" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                     Text="Apply deterministic random variation to the selected notes. Disabled fields remain unchanged."/>

          <Border Margin="0,0,0,14" Padding="12,10" Background="{StaticResource Brush.Surface.1}"
                  BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="72"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Seed"/>
              <RadioButton x:Name="AutomaticSeedButton" Grid.Column="1" VerticalAlignment="Center"
                           GroupName="SeedMode" IsChecked="True" Content="Automatic"
                           Checked="OnSeedModeChanged"/>
              <RadioButton x:Name="ExplicitSeedButton" Grid.Column="3" VerticalAlignment="Center"
                           GroupName="SeedMode" Content="Explicit" Checked="OnSeedModeChanged"/>
              <TextBox x:Name="SeedBox" Grid.Column="5" IsEnabled="False" Text="0"
                       TextChanged="OnInputChanged"/>
            </Grid>
          </Border>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="86"/>
              <ColumnDefinition Width="150"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="25"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="12"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" Text="MODE"/>
            <TextBlock Grid.Column="3" Style="{StaticResource Text.Caption}" Text="MINIMUM"/>
            <TextBlock Grid.Column="5" Style="{StaticResource Text.Caption}" Text="MAXIMUM"/>

            <TextBlock Grid.Row="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Tick"/>
            <ComboBox x:Name="TickModeBox" Grid.Row="1" Grid.Column="1" SelectedIndex="0"
                      SelectionChanged="OnFieldModeChanged"/>
            <TextBox x:Name="TickMinimumBox" Grid.Row="1" Grid.Column="3" Text="0" IsEnabled="False"
                     TextChanged="OnInputChanged"/>
            <TextBox x:Name="TickMaximumBox" Grid.Row="1" Grid.Column="5" Text="0" IsEnabled="False"
                     TextChanged="OnInputChanged"/>

            <TextBlock Grid.Row="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="Gate"/>
            <ComboBox x:Name="GateModeBox" Grid.Row="3" Grid.Column="1" SelectedIndex="0"
                      SelectionChanged="OnFieldModeChanged"/>
            <TextBox x:Name="GateMinimumBox" Grid.Row="3" Grid.Column="3" Text="0" IsEnabled="False"
                     TextChanged="OnInputChanged"/>
            <TextBox x:Name="GateMaximumBox" Grid.Row="3" Grid.Column="5" Text="0" IsEnabled="False"
                     TextChanged="OnInputChanged"/>

            <TextBlock Grid.Row="5" VerticalAlignment="Center" FontWeight="SemiBold" Text="Velocity"/>
            <ComboBox x:Name="VelocityModeBox" Grid.Row="5" Grid.Column="1" SelectedIndex="0"
                      SelectionChanged="OnFieldModeChanged"/>
            <TextBox x:Name="VelocityMinimumBox" Grid.Row="5" Grid.Column="3" Text="0" IsEnabled="False"
                     TextChanged="OnInputChanged"/>
            <TextBox x:Name="VelocityMaximumBox" Grid.Row="5" Grid.Column="5" Text="0" IsEnabled="False"
                     TextChanged="OnInputChanged"/>
          </Grid>

          <TextBlock Margin="86,14,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                     Text="Add and Override use inclusive integer ranges. Multiply accepts finite factors greater than or equal to zero."/>
          <TextBlock x:Name="ValidationText" Margin="86,10,0,0" Style="{StaticResource Text.Caption}"
                     Foreground="{StaticResource Brush.Red.Hover}" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="2" Padding="12,10" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center" Orientation="Horizontal">
          <Button Margin="0,0,6,0" IsCancel="True" Style="{StaticResource Button.Dialog.Cancel}"
                  Content="Cancel" Click="OnCancelClick"/>
          <Button IsDefault="True" Style="{StaticResource Button.Dialog.Confirm}"
                  Content="Apply" Click="OnApplyClick"/>
        </StackPanel>
      </Border>
    </Grid>
  </Border>
</Window>
