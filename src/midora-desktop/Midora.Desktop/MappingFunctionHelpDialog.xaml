<Window x:Class="Midora.Desktop.MappingFunctionHelpDialog"
        FontFamily="{StaticResource Font.UI}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Width="780" Height="650" MinWidth="620" MinHeight="480" MaxHeight="820"
        Background="{StaticResource Brush.Surface.0}" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="36" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
        <TextBlock Margin="11,0,44,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Mapping Function Help"/>
        <Button Width="46" Height="36" HorizontalAlignment="Right" Style="{StaticResource Button.Caption.Close}" Click="OnCloseClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>
      <ScrollViewer Grid.Row="1" Padding="16,14" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Section}" Text="One bounded numeric expression"/>
          <TextBlock Margin="0,4,0,14" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                     Text="The result is converted to the Mapping Step's numeric target. Statements, assignments, loops, object creation, reflection, I/O, and arbitrary .NET calls are not available."/>

          <TextBlock Style="{StaticResource Text.Section}" Text="Inputs"/>
          <Grid Margin="0,8,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock FontFamily="{StaticResource Font.Mono}" Text="value"/>
            <TextBlock Grid.Column="1" Style="{StaticResource Text.Caption}" Text="The data-domain value entering this Mapping Step (not the friendly editor value). CC10/71–78 remain MIDI 0–127 here. Example: MIDI 96 is shown as 32; value*0.5 returns MIDI 48 (shown as -16). Batch Edit =p0*0.5 instead halves display 32 to 16." TextWrapping="Wrap"/>
            <TextBlock Grid.Row="1" FontFamily="{StaticResource Font.Mono}" Text="context"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Text.Caption}" Text="The bounded MappingContextV2 snapshot. Type context. and press Ctrl+Space to inspect its legal fields." TextWrapping="Wrap"/>
            <TextBlock Grid.Row="2" FontFamily="{StaticResource Font.Mono}" Text="Math"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Text.Caption}" Text="The approved System.Math numeric methods and constants are implicitly imported. Use Sin(value) or Math.Sin(value); press Ctrl+Space for the exact allowlist." TextWrapping="Wrap"/>
          </Grid>

          <TextBlock Style="{StaticResource Text.Section}" Text="Examples"/>
          <Border Margin="0,8,0,6" Padding="10,8" Style="{StaticResource Card}"><StackPanel><TextBlock FontFamily="{StaticResource Font.Mono}" Foreground="#DCDCAA" Text="value"/><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="Identity: preserve the incoming value."/></StackPanel></Border>
          <Border Margin="0,0,0,6" Padding="10,8" Style="{StaticResource Card}"><StackPanel><TextBlock FontFamily="{StaticResource Font.Mono}" Foreground="#DCDCAA" Text="Clamp(value * 1.25, 0, 127)"/><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="Scale and clamp a MIDI-range value without the optional Math. prefix."/></StackPanel></Border>
          <Border Margin="0,0,0,6" Padding="10,8" Style="{StaticResource Card}"><StackPanel><TextBlock FontFamily="{StaticResource Font.Mono}" Foreground="#DCDCAA" Text="context.TriggerVelocity * (value / 127.0)"/><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="Combine the source value with the current note's trigger velocity."/></StackPanel></Border>
          <Border Margin="0,0,0,14" Padding="10,8" Style="{StaticResource Card}"><StackPanel><TextBlock FontFamily="{StaticResource Font.Mono}" Foreground="#DCDCAA" Text="Round(Clamp(value + Sin(context.TemplateTick / 48.0) * 12, 0, 127))" TextWrapping="Wrap"/><TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}" Text="Apply a bounded periodic offset using the source Template Event tick."/></StackPanel></Border>

          <TextBlock Style="{StaticResource Text.Section}" Text="Editing"/>
          <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                     Text="Ctrl+Space opens completion. Matching parentheses are highlighted. Validate checks the exact formal Mapping ABI and allowlist. OK validates again and submits one atomic Project edit; Cancel discards the dialog contents."/>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Padding="12,11" Background="{StaticResource Brush.Surface.1}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <Button HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Style="{StaticResource Button.Dialog.Confirm}" Content="OK" Click="OnCloseClick"/>
      </Border>
    </Grid>
  </Border>
</Window>
