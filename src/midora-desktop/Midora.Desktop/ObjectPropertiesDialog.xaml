<Window x:Class="Midora.Desktop.ObjectPropertiesDialog"
        FontFamily="{StaticResource Font.UI}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="Properties"
        Width="520" Height="620" MinWidth="420" MinHeight="320" MaxHeight="820"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="None"
        ShowInTaskbar="False" Background="{StaticResource Brush.Surface.0}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseLeftButtonDown">
        <TextBlock Margin="12,0,50,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="Properties" TextTrimming="CharacterEllipsis"/>
        <Button Width="46" Height="38" HorizontalAlignment="Right"
                Style="{StaticResource Button.Caption.Close}" Click="OnCancelClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}" Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>

      <Border Grid.Row="1" Padding="18,14" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
        <StackPanel>
          <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
          <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Caption}"
                     Text="{Binding Context}" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <ScrollViewer Grid.Row="2" Padding="18" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <ItemsControl ItemsSource="{Binding Fields}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="0,0,0,10">
                  <TextBlock Margin="0,0,0,4" Style="{StaticResource Text.Caption}" Text="{Binding Label}"/>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                      <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                          <Setter Property="IsReadOnly" Value="True"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsInputEnabled}" Value="True"/>
                                <Condition Binding="{Binding CanEdit, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                              </MultiDataTrigger.Conditions>
                              <Setter Property="IsReadOnly" Value="False"/>
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBox.Style>
                    </TextBox>
                    <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label"
                              SelectedValuePath="Value" SelectedValue="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                      <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Setter Property="IsEnabled" Value="False"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChoice}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChoice}" Value="True"/>
                                <Condition Binding="{Binding IsInputEnabled}" Value="True"/>
                                <Condition Binding="{Binding CanEdit, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                              </MultiDataTrigger.Conditions>
                              <Setter Property="IsEnabled" Value="True"/>
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </ComboBox.Style>
                    </ComboBox>
                    <CheckBox Content="Enabled"
                              IsChecked="{Binding BooleanValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                      <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Setter Property="IsEnabled" Value="False"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBoolean}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                            <MultiDataTrigger>
                              <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsBoolean}" Value="True"/>
                                <Condition Binding="{Binding IsInputEnabled}" Value="True"/>
                                <Condition Binding="{Binding CanEdit, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="True"/>
                              </MultiDataTrigger.Conditions>
                              <Setter Property="IsEnabled" Value="True"/>
                            </MultiDataTrigger>
                          </Style.Triggers>
                        </Style>
                      </CheckBox.Style>
                    </CheckBox>
                    <Button Grid.Column="1" Width="32" Height="30" Margin="6,0,0,0" Padding="0"
                            Style="{StaticResource Button.Ghost}" Tag="{Binding}"
                            IsEnabled="{Binding CanEdit, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            ToolTip="Edit all selected objects as one value"
                            Visibility="{Binding CanActivateMixed, Converter={StaticResource BooleanToVisibility}}"
                            Click="OnActivateMixedClick">
                      <ui:FluentIcon Width="14" Height="14" Data="{StaticResource Fluent.Add20Regular}"/>
                    </Button>
                    <Button Grid.Column="2" Width="32" Height="30" Margin="4,0,0,0" Padding="0"
                            Style="{StaticResource Button.Ghost}" Tag="{Binding}"
                            IsEnabled="{Binding CanEdit, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            ToolTip="Restore original value"
                            Visibility="{Binding CanReset, Converter={StaticResource BooleanToVisibility}}"
                            Click="OnResetFieldClick">
                      <ui:FluentIcon Width="14" Height="14" Data="{StaticResource Fluent.ArrowUndo20Regular}"/>
                    </Button>
                  </Grid>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Margin="0,4,0,0" Foreground="{StaticResource Brush.Red.Hover}"
                     Text="{Binding ErrorText}" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Row="3" MinHeight="58" Padding="12,10" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
          <Button Margin="0,0,8,0" Style="{StaticResource Button.Dialog.Cancel}" Content="Cancel"/>
          <Button Style="{StaticResource Button.Dialog.Confirm}" Content="OK" Click="OnConfirmClick"/>
        </StackPanel>
      </Border>
      <Border x:Name="PropertyTaskOverlay" Grid.RowSpan="4" Panel.ZIndex="1000"
              Visibility="Collapsed" Background="#E6101216" Focusable="True">
        <Border Margin="24" Padding="20" VerticalAlignment="Center"
                Background="{StaticResource Brush.Surface.1}"
                BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="4">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Name}" TextWrapping="Wrap"/>
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Caption}" Text="{Binding Detail}" TextWrapping="Wrap"/>
            <ProgressBar Margin="0,18,0,0" Height="7" Minimum="0" Maximum="1"
                         Value="{Binding Progress, Mode=OneWay, TargetNullValue=0}">
              <ProgressBar.Style>
                <Style TargetType="ProgressBar" BasedOn="{StaticResource TaskProgressBar}">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Progress}" Value="{x:Null}">
                      <Setter Property="IsIndeterminate" Value="True"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>
            <Button x:Name="PropertyTaskCancelButton" Content="Cancel" MinWidth="92"
                    Margin="0,16,0,0" HorizontalAlignment="Right"
                    IsEnabled="{Binding CanRequestCancel}" Click="OnCancelTaskClick"/>
          </StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</Window>
