<Window x:Class="Midora.Desktop.OnionSourcesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        FontFamily="{DynamicResource Font.UI}" Width="510" Height="510" MinWidth="420" MinHeight="360"
        Background="{DynamicResource Brush.Surface.0}" WindowStyle="None" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        UseLayoutRounding="True" PreviewKeyDown="OnDialogKeyDown">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False"/></shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="60"/></Grid.RowDefinitions>
    <Grid Background="{DynamicResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseDown">
      <TextBlock Margin="12,0,48,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Title}"/>
      <Button HorizontalAlignment="Right" Width="46" Height="36" Style="{DynamicResource Button.Caption.Close}" Click="OnCancel"><ui:FluentIcon Style="{DynamicResource Icon.WindowControl}" Data="{DynamicResource WindowControl.Close}"/></Button>
    </Grid>
    <StackPanel Grid.Row="1" Margin="14,12">
      <TextBlock Text="Choose your custom sources. OK enables onion skin and shows these sources instead of the previous/next shortcut." TextWrapping="Wrap" Style="{DynamicResource Text.Muted}"/>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="Select All" Margin="0,0,6,0" Click="OnSelectAll"/><Button Content="Clear" Click="OnClear"/></StackPanel>
    </StackPanel>
    <Border Grid.Row="2" Margin="14,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Sources}"><ItemsControl.ItemTemplate><DataTemplate>
          <CheckBox Margin="9,6" IsChecked="{Binding Included}" HorizontalContentAlignment="Stretch">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="4" Height="18" Margin="0,0,9,0" Background="{Binding Color}"/>
              <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding Name}" TextWrapping="Wrap"/>
            </Grid>
          </CheckBox>
        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </ScrollViewer>
    </Border>
    <Border Grid.Row="3" Padding="12,10" Background="{DynamicResource Brush.Surface.1}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
      <Grid><Button Content="Help" HorizontalAlignment="Left" Click="OnHelp"/>
        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal"><Button Style="{DynamicResource Button.Dialog.Cancel}" Margin="0,0,6,0" Content="Cancel" Click="OnCancel"/><Button Style="{DynamicResource Button.Dialog.Confirm}" Content="OK" Click="OnAccept"/></StackPanel>
      </Grid>
    </Border>
  </Grid></Border>
</Window>
