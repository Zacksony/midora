<Window x:Class="Midora.Desktop.InstrumentCatalogDialog"
        FontFamily="{StaticResource Font.UI}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:interaction="clr-namespace:Midora.Desktop.Presentation.Interaction;assembly=Midora.Desktop.Presentation"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation"
        Title="Instrument Catalogs" Width="1180" Height="780" MinWidth="960" MinHeight="650"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" WindowStyle="None"
        ShowInTaskbar="False" Background="{StaticResource Brush.Surface.0}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="OnPreviewKeyDown" Closed="OnClosed">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" CornerRadius="0" GlassFrameThickness="0"
                        ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Border BorderBrush="{StaticResource Brush.Border.Strong}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="58"/>
      </Grid.RowDefinitions>

      <Grid x:Name="CatalogTitleBar" Background="{StaticResource Brush.Black}" MouseLeftButtonDown="OnTitleMouseDown">
        <TextBlock Margin="12,0,50,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Text="Instrument Catalogs"/>
        <Button x:Name="CatalogCloseButton" Width="46" Height="38" HorizontalAlignment="Right"
                Style="{StaticResource Button.Caption.Close}" ToolTip="Close" Click="OnCancelClick">
          <ui:FluentIcon Style="{StaticResource Icon.WindowControl}"
                         Data="{StaticResource WindowControl.Close}"/>
        </Button>
      </Grid>

      <Border x:Name="CatalogHeader" Grid.Row="1" Padding="16,11" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <CheckBox x:Name="GeneralMidiEnabledBox" VerticalAlignment="Center"
                    Content="Enable built-in General MIDI names"
                    Click="OnCatalogResolutionInputsChanged"/>
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.Caption}"
                     TextWrapping="Wrap"
                     Text="Display priority: User Override → enabled SoundFont order → User Profile order → General MIDI → numeric fallback. Names never change Project MIDI values."/>
        </Grid>
      </Border>

      <TabControl x:Name="CatalogTabs" Grid.Row="2" Margin="12,10,12,0"
                  SelectionChanged="OnCatalogTabSelectionChanged">
        <TabItem Header="Profiles">
          <Grid Margin="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="300"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="330"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="9">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Style="{StaticResource Text.Section}" Text="Catalog Profiles"/>
                <WrapPanel Grid.Row="1" Margin="0,8,0,8">
                  <Button Margin="0,0,5,5" Padding="9,4" Content="New" Click="OnNewProfileClick"/>
                  <Button Margin="0,0,5,5" Padding="9,4" Content="Rename" Click="OnRenameProfileClick"/>
                  <Button Margin="0,0,5,5" Padding="9,4" Content="Delete" Click="OnDeleteProfileClick"/>
                  <Button Margin="0,0,5,5" Padding="9,4" Content="Up" Click="OnMoveProfileUpClick"/>
                  <Button Margin="0,0,5,5" Padding="9,4" Content="Down" Click="OnMoveProfileDownClick"/>
                  <Button Margin="0,0,5,5" Padding="9,4" Content="Import…" Click="OnImportProfileClick"/>
                  <Button Margin="0,0,5,5" Padding="9,4" Content="Export…" Click="OnExportProfileClick"/>
                  <Button Margin="0,0,5,5" Padding="9,4" Content="Scan SF2…" Click="OnScanSf2Click"/>
                  <Button Margin="0,0,5,5" Padding="9,4" Content="Rescan" Click="OnRescanSf2Click"/>
                </WrapPanel>
                <ListBox x:Name="ProfileList" Grid.Row="2" SelectionChanged="OnProfileSelectionChanged"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="1,2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <CheckBox Margin="0,1,8,0" VerticalAlignment="Top" IsChecked="{Binding Enabled}"
                                  Click="OnCatalogResolutionInputsChanged"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding SourceLabel}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="9">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                  <TextBlock Style="{StaticResource Text.Section}" Text="Banks"/>
                  <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,5,0" Padding="9,4" Content="New" Click="OnNewBankClick"/>
                    <Button Padding="9,4" Content="Delete" Click="OnDeleteBankClick"/>
                  </StackPanel>
                </Grid>
                <ListBox x:Name="BankList" Grid.Row="1" Margin="0,8,0,8"
                         interaction:ScrollViewerWheelRouter.UseSingleItemWheel="True"
                         SelectionChanged="OnBankSelectionChanged" DisplayMemberPath="DisplayText"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"/>
                <Border Grid.Row="2" Padding="8" Background="{StaticResource Brush.Surface.1}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3">
                  <StackPanel>
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel><TextBlock Style="{StaticResource Text.Overline}" Text="BANK MSB"/><TextBox x:Name="BankMsbBox" Margin="0,4,0,0"/></StackPanel>
                      <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Text.Overline}" Text="BANK LSB"/><TextBox x:Name="BankLsbBox" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Overline}" Text="DISPLAY NAME (OPTIONAL)"/>
                    <TextBox x:Name="BankNameBox" Margin="0,4,0,0"/>
                    <Button x:Name="ApplyBankButton" Margin="0,8,0,0" HorizontalAlignment="Right"
                            Padding="12,4" Content="Apply Bank" Click="OnApplyBankClick"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="9">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                  <TextBlock Style="{StaticResource Text.Section}" Text="Programs"/>
                  <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,5,0" Padding="9,4" Content="New" Click="OnNewProgramClick"/>
                    <Button Padding="9,4" Content="Delete" Click="OnDeleteProgramClick"/>
                  </StackPanel>
                </Grid>
                <ListBox x:Name="ProgramList" Grid.Row="1" Margin="0,8,0,8"
                         interaction:ScrollViewerWheelRouter.UseSingleItemWheel="True"
                         SelectionChanged="OnProgramSelectionChanged" DisplayMemberPath="DisplayText"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"/>
                <Border Grid.Row="2" Padding="8" Background="{StaticResource Brush.Surface.1}"
                        BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="3">
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Overline}" Text="PROGRAM"/>
                    <TextBox x:Name="ProgramNumberBox" Margin="0,4,0,0"/>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Overline}" Text="DISPLAY NAME"/>
                    <TextBox x:Name="ProgramNameBox" Margin="0,4,0,0"/>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Overline}" Text="EFFECTIVE CATALOG NAME"/>
                    <TextBlock x:Name="ResolvedProgramText" Margin="0,4,0,0"
                               Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
                    <Button x:Name="ApplyProgramButton" Margin="0,8,0,0" HorizontalAlignment="Right"
                            Padding="12,4" Content="Apply Program" Click="OnApplyProgramClick"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>
        </TabItem>

        <TabItem Header="User Overrides">
          <Grid Margin="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="9">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid>
                  <StackPanel>
                    <TextBlock Style="{StaticResource Text.Section}" Text="Highest-priority Names"/>
                    <TextBlock Margin="0,3,120,0" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"
                               Text="An override applies to one exact Bank MSB / Bank LSB / Program address."/>
                  </StackPanel>
                  <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Margin="0,0,5,0" Padding="9,4" Content="New" Click="OnNewOverrideClick"/>
                    <Button Padding="9,4" Content="Delete" Click="OnDeleteOverrideClick"/>
                  </StackPanel>
                </Grid>
                <ListBox x:Name="OverrideList" Grid.Row="1" Margin="0,9,0,0"
                         SelectionChanged="OnOverrideSelectionChanged" DisplayMemberPath="DisplayText"
                         ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"/>
              </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
              <StackPanel>
                <TextBlock Style="{StaticResource Text.Section}" Text="Override Properties"/>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <StackPanel><TextBlock Style="{StaticResource Text.Overline}" Text="BANK MSB"/><TextBox x:Name="OverrideMsbBox" Margin="0,4,0,0"/></StackPanel>
                  <StackPanel Grid.Column="2"><TextBlock Style="{StaticResource Text.Overline}" Text="BANK LSB"/><TextBox x:Name="OverrideLsbBox" Margin="0,4,0,0"/></StackPanel>
                  <StackPanel Grid.Column="4"><TextBlock Style="{StaticResource Text.Overline}" Text="PROGRAM"/><TextBox x:Name="OverrideProgramBox" Margin="0,4,0,0"/></StackPanel>
                </Grid>
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Overline}" Text="BANK DISPLAY NAME (OPTIONAL)"/>
                <TextBox x:Name="OverrideBankNameBox" Margin="0,4,0,0"/>
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Overline}" Text="PROGRAM DISPLAY NAME (OPTIONAL)"/>
                <TextBox x:Name="OverrideProgramNameBox" Margin="0,4,0,0"/>
                <Button Margin="0,12,0,0" HorizontalAlignment="Right" Padding="12,4"
                        Content="Apply Override" Click="OnApplyOverrideClick"/>
              </StackPanel>
            </Border>
          </Grid>
        </TabItem>
      </TabControl>

      <Border x:Name="ValidationBorder" Grid.Row="3" Margin="16,8,16,0" Padding="9"
              Background="{StaticResource Brush.Red.Subtle}" BorderBrush="{StaticResource Brush.Red}"
              BorderThickness="1" CornerRadius="3" Visibility="Collapsed">
        <TextBlock x:Name="ValidationText" Foreground="{StaticResource Brush.Red.Hover}" TextWrapping="Wrap"/>
      </Border>

      <Border x:Name="CatalogFooter" Grid.Row="4" Padding="10" Background="{StaticResource Brush.Surface.1}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
        <Grid>
          <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Caption}"
                     Text="Changes remain a draft until OK. Catalog data never enters a Project."/>
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
            <Button Margin="0,0,7,0" Style="{StaticResource Button.Dialog.Cancel}"
                    Content="Cancel" IsCancel="True" Click="OnCancelClick"/>
            <Button x:Name="CatalogOkButton" Style="{StaticResource Button.Dialog.Confirm}"
                    Content="OK" IsDefault="True" Click="OnOkClick"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid x:Name="ScanOverlay" Grid.RowSpan="5" Panel.ZIndex="100" Visibility="Collapsed"
            Background="#B8000000" KeyboardNavigation.TabNavigation="Cycle"
            KeyboardNavigation.ControlTabNavigation="Cycle">
        <Border Width="720" MaxHeight="610" Margin="24" Padding="14" VerticalAlignment="Center"
                Background="{StaticResource Brush.Surface.0}" BorderBrush="{StaticResource Brush.Border.Strong}"
                BorderThickness="1" CornerRadius="4">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Text.Title}" Text="Scan SF2 Presets"/>
            <StackPanel Grid.Row="1" Margin="0,8,0,10">
              <TextBlock x:Name="ScanSourceText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
              <TextBlock Margin="0,9,0,0" Style="{StaticResource Text.Overline}" Text="PROFILE NAME"/>
              <TextBox x:Name="ScanProfileNameBox" Margin="0,4,0,0"/>
            </StackPanel>
            <Grid x:Name="ScanMappingPanel" Grid.Row="2">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Grid Margin="3,0,20,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Text.Overline}" Text="RAW BANK"/>
                <TextBlock Grid.Column="1" Style="{StaticResource Text.Overline}" Text="PRESETS"/>
                <TextBlock Grid.Column="2" Style="{StaticResource Text.Overline}" Text="TARGET MSB"/>
                <TextBlock Grid.Column="3" Style="{StaticResource Text.Overline}" Text="TARGET LSB"/>
              </Grid>
              <ListBox x:Name="ScanBankList" Grid.Row="1" MaxHeight="330"
                       interaction:ScrollViewerWheelRouter.UseSingleItemWheel="True"
                       ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                       VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="3,2">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                      <TextBlock VerticalAlignment="Center" Text="{Binding RawBank}"/>
                      <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Caption}" Text="{Binding PresetCountText}"/>
                      <TextBox Grid.Column="2" Margin="3,0" Text="{Binding TargetMsbText, UpdateSourceTrigger=PropertyChanged}"/>
                      <TextBox Grid.Column="3" Margin="3,0" Text="{Binding TargetLsbText, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
            <TextBlock x:Name="ScanStatusText" Grid.Row="3" Margin="0,9,0,0"
                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="4" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Width="112" Margin="0,0,7,0" Content="Cancel" Click="OnCancelScanClick"/>
              <Button x:Name="ApplyScanButton" Width="132" Style="{StaticResource Button.Primary}"
                      Content="Import Snapshot" Click="OnApplyScanClick"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <Grid x:Name="ImportOverlay" Grid.RowSpan="5" Panel.ZIndex="101" Visibility="Collapsed"
            Background="#B8000000" KeyboardNavigation.TabNavigation="Cycle"
            KeyboardNavigation.ControlTabNavigation="Cycle">
        <Border Width="760" MaxHeight="620" Margin="24" Padding="14" VerticalAlignment="Center"
                Background="{StaticResource Brush.Surface.0}" BorderBrush="{StaticResource Brush.Border.Strong}"
                BorderThickness="1" CornerRadius="4">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Style="{StaticResource Text.Title}" Text="Import Catalog Profile"/>
            <TextBlock x:Name="ImportSourceText" Grid.Row="1" Margin="0,7,0,10"
                       Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="2">
              <TextBlock Style="{StaticResource Text.Overline}" Text="REPLACE OR MERGE TARGET"/>
              <ComboBox x:Name="ImportTargetBox" Margin="0,4,0,8" DisplayMemberPath="DisplayName"
                        SelectionChanged="OnImportTargetChanged"/>
              <TextBlock x:Name="ImportSummaryText" Style="{StaticResource Text.Caption}" TextWrapping="Wrap"/>
            </StackPanel>
            <ListBox x:Name="ImportConflictList" Grid.Row="3" Margin="0,9,0,0" MaxHeight="310"
                     ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"/>
            <StackPanel Grid.Row="4" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
              <Button Width="112" Margin="0,0,7,0" Content="Cancel" Click="OnCancelImportClick"/>
              <Button x:Name="ReplaceImportedProfileButton" Width="132" Margin="0,0,7,0" Content="Replace Profile" Click="OnReplaceImportedProfileClick"/>
              <Button x:Name="MergeImportedProfileButton" Width="144" Style="{StaticResource Button.Primary}"
                      Content="Apply Merge" Click="OnMergeImportedProfileClick"/>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
