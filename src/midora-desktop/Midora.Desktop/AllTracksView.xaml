<UserControl x:Class="Midora.Desktop.AllTracksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls;assembly=Midora.Desktop.Presentation">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
    <Border Padding="8,0" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox x:Name="ModeSelector" Width="110" Height="24" Margin="8,0" VerticalAlignment="Center" ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" ToolTip="Raw: source notes. Compiled: logical expansion plus source MIDI notes." SelectionChanged="OnModeChanged" DropDownClosed="OnModeDropDownClosed"/>
          <ToggleButton Content="Grid" IsChecked="{Binding EditorSettings.GridVisible}" Margin="0,0,6,0"/>
          <Button Style="{DynamicResource Button.TimelineIcon}" ToolTip="Zoom out" Click="OnZoomOut"><ui:FluentIcon Width="13" Height="13" Data="{DynamicResource Fluent.ZoomOut20Regular}"/></Button>
          <Button Style="{DynamicResource Button.TimelineIcon}" Margin="0,0,6,0" ToolTip="Zoom in" Click="OnZoomIn"><ui:FluentIcon Width="13" Height="13" Data="{DynamicResource Fluent.ZoomIn20Regular}"/></Button>
          <Button Height="24" Padding="7,0" Content="Fit" Click="OnFit"/>
          <Button Height="24" Padding="7,0" Content="Refresh" Margin="4,0,0,0" Click="OnRefresh" ToolTip="Rebuild the logical note index from the last successful compilation"/>
          <Button Height="24" Padding="7,0" Content="Cancel" Margin="4,0,0,0" IsEnabled="{Binding IsBuilding}" Click="OnCancelBuild"/>
          <Button Height="24" Padding="7,0" Content="Help" Margin="4,0,0,0" Click="OnHelp"/>
        </StackPanel>
        <TextBlock x:Name="StatusText" Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}">
          <TextBlock.Style><Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}"/>
            <Setter Property="FontFamily" Value="{DynamicResource Font.UI}"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSize.Body}"/>
            <Style.Triggers><DataTrigger Binding="{Binding IsStale}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Brush.Warning}"/></DataTrigger></Style.Triggers>
          </Style></TextBlock.Style>
        </TextBlock>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/></Grid.ColumnDefinitions>
      <ui:TimelineSurface x:Name="Timeline" Snapshot="{Binding Snapshot}" OnionSnapshot="{Binding OnionSnapshot}" PreviewMouseDown="OnReadOnlyMouseDown"
          PreviewMouseUp="OnFollowMouseUp" LostMouseCapture="OnFollowLostMouseCapture"
          SurfaceMode="PianoRoll" CanEdit="False" IsTimeRangeSelectionEnabled="False" OnionIsPrimaryLayer="True"
          PlaybackCursorTick="{Binding PlaybackCursorTick}"
          StartTick="{Binding StartTick, Mode=TwoWay}" TickSpan="{Binding TickSpan, Mode=TwoWay}"
          FirstLane="{Binding FirstLane, Mode=TwoWay}" LaneHeight="{Binding LaneHeight, Mode=TwoWay}"
          DisplayGridUsesBars="True" TimeSignatureMap="{Binding EditorSettings.TimeSignatureMap}"
          GridVisible="{Binding EditorSettings.GridVisible}" GridStepTicks="{Binding EditorSettings.DisplayGridStepTicks}"/>
      <ui:TimelinePlaybackCursorOverlay SurfaceMode="PianoRoll" StartTick="{Binding StartTick, ElementName=Timeline}"
          TickSpan="{Binding TickSpan, ElementName=Timeline}" PlaybackCursorTick="{Binding PlaybackCursorTick}"/>
      <ScrollBar Grid.Column="1" Orientation="Vertical" Maximum="{Binding MaximumFirstLane, ElementName=Timeline}"
          Value="{Binding FirstLane, ElementName=Timeline, Mode=TwoWay}" SmallChange="1"
          ViewportSize="{Binding VisibleLaneCount, ElementName=Timeline}"/>
    </Grid>
    <ui:TimelineOverviewSurface x:Name="Overview" Grid.Row="2" StartTick="{Binding StartTick, Mode=TwoWay}" TickSpan="{Binding TickSpan}" ExtentEndTick="{Binding ExtentEndTick}"
        PlaybackCursorTick="{Binding PlaybackCursorTick}" PreviewMouseDown="OnFollowMouseDown" PreviewMouseUp="OnFollowMouseUp"
        PreviewMouseWheel="OnFollowOverviewMouseWheel" LostMouseCapture="OnFollowLostMouseCapture"/>
  </Grid>
</UserControl>
