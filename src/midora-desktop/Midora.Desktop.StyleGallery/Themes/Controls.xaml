<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:interaction="clr-namespace:Midora.Desktop.Presentation.Interaction"
                    xmlns:ui="clr-namespace:Midora.Desktop.Presentation.Controls">

  <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}"
         TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-3"
                     RadiusX="4"
                     RadiusY="4"
                     Stroke="{StaticResource Brush.Text.Tertiary}"
                     StrokeDashArray="2,2"
                     StrokeThickness="1" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Focus.Caption" TargetType="Control">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-1"
                     Stroke="{StaticResource Brush.Text.Tertiary}"
                     StrokeDashArray="2,2"
                     StrokeThickness="1" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Window">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="Background" Value="{StaticResource Brush.Surface.0}" />
  </Style>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style TargetType="{x:Type ui:FluentIcon}">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ui:FluentIcon}">
          <Viewbox Width="{TemplateBinding Width}"
                   Height="{TemplateBinding Height}"
                   Stretch="Uniform">
            <Path Data="{TemplateBinding Data}"
                  Fill="{TemplateBinding Foreground}"
                  Stretch="Uniform" />
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Icon.WindowControl" TargetType="{x:Type ui:FluentIcon}">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ui:FluentIcon}">
          <Grid Width="10"
                Height="10"
                SnapsToDevicePixels="True"
                UseLayoutRounding="True">
            <Path x:Name="Glyph"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch"
                  Data="{TemplateBinding Data}"
                  Fill="{TemplateBinding Foreground}"
                  SnapsToDevicePixels="True"
                  Stretch="Uniform" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="PixelAligned">
              <Setter TargetName="Glyph" Property="RenderOptions.EdgeMode" Value="Aliased" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Icon.WindowControl.Minimize"
         TargetType="{x:Type ui:FluentIcon}"
         BasedOn="{StaticResource Icon.WindowControl}">
    <Setter Property="Opacity" Value="0.75" />
    <Setter Property="Tag" Value="PixelAligned" />
  </Style>

  <Style x:Key="Icon.CommandBar"
         TargetType="{x:Type ui:FluentIcon}"
         BasedOn="{StaticResource {x:Type ui:FluentIcon}}">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <Style x:Key="Icon.NativeCanvas16"
         TargetType="{x:Type ui:FluentIcon}"
         BasedOn="{StaticResource {x:Type ui:FluentIcon}}">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ui:FluentIcon}">
          <Canvas Width="16" Height="16"
                  SnapsToDevicePixels="True"
                  UseLayoutRounding="True">
            <Path Data="{TemplateBinding Data}"
                  Fill="{TemplateBinding Foreground}"
                  Stretch="None" />
          </Canvas>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Icon.DesignCanvas20At16"
         TargetType="{x:Type ui:FluentIcon}"
         BasedOn="{StaticResource {x:Type ui:FluentIcon}}">
    <Setter Property="Width" Value="16" />
    <Setter Property="Height" Value="16" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ui:FluentIcon}">
          <Viewbox Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                   Stretch="Uniform"
                   SnapsToDevicePixels="True">
            <Canvas Width="20" Height="20"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True">
              <Path x:Name="Glyph"
                    Data="{TemplateBinding Data}"
                    Fill="{TemplateBinding Foreground}"
                    Stretch="None" />
            </Canvas>
          </Viewbox>
          <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Emphasized">
              <Setter TargetName="Glyph" Property="RenderTransform">
                <Setter.Value>
                  <ScaleTransform CenterX="10" CenterY="10" ScaleX="1.1" ScaleY="1.1" />
                </Setter.Value>
              </Setter>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Icon.Stepper" TargetType="{x:Type ui:FluentIcon}">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ui:FluentIcon}">
          <Viewbox Width="{TemplateBinding Width}"
                   Height="{TemplateBinding Height}"
                   Stretch="Uniform">
            <Canvas Width="20" Height="20">
              <Path Data="{TemplateBinding Data}"
                    Fill="{TemplateBinding Foreground}" />
            </Canvas>
          </Viewbox>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Text.Title"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Title}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>

  <Style x:Key="Text.Section"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
  </Style>

  <Style x:Key="Text.Overline"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Red.Hover}" />
  </Style>

  <Style x:Key="Text.Muted"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>

  <Style x:Key="Text.Caption"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Tertiary}" />
  </Style>

  <Style x:Key="Text.Mono"
         TargetType="TextBlock"
         BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface.1}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{StaticResource Radius.Medium}" />
    <Setter Property="Padding" Value="{StaticResource Thickness.CardPadding}" />
  </Style>

  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Brush.Surface.3}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="7,2" />
  </Style>

  <Style x:Key="Badge.Error" TargetType="Border" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{StaticResource Brush.Red.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Red.Dark}" />
  </Style>

  <Style x:Key="Badge.Warning" TargetType="Border" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{StaticResource Brush.Warning.Subtle}" />
    <Setter Property="BorderBrush" Value="#735820" />
  </Style>

  <Style x:Key="Badge.Info" TargetType="Border" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{StaticResource Brush.Info.Subtle}" />
    <Setter Property="BorderBrush" Value="#28517A" />
  </Style>

  <Style x:Key="Badge.Success" TargetType="Border" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{StaticResource Brush.Success.Subtle}" />
    <Setter Property="BorderBrush" Value="#285D40" />
  </Style>

  <Style x:Key="Badge.Damaged" TargetType="Border" BasedOn="{StaticResource Badge}">
    <Setter Property="Background" Value="{StaticResource Brush.Damaged.Subtle}" />
    <Setter Property="BorderBrush" Value="#694085" />
  </Style>

  <Style x:Key="Badge.Count" TargetType="Border" BasedOn="{StaticResource Badge}">
    <Setter Property="MinWidth" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="UseLayoutRounding" Value="True" />
  </Style>

  <Style x:Key="Badge.Count.Error" TargetType="Border" BasedOn="{StaticResource Badge.Count}">
    <Setter Property="Background" Value="{StaticResource Brush.Red.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Red.Dark}" />
  </Style>

  <Style x:Key="Button.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Background" Value="{StaticResource Brush.Surface.3}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Strong}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Small}"
                  SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Content"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Surface.4}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Text.Tertiary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Black}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Red.Dark}" />
              <Setter TargetName="Content" Property="Margin" Value="0,1,0,-1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Background" Value="{Binding Background, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button" BasedOn="{StaticResource Button.Base}" />

  <Style x:Key="Button.TimelineIcon" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Width" Value="26"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="0,0,2,0"/>
  </Style>

  <!-- A menu-opening Button with a read-only active state in Tag; clicking does not toggle it. -->
  <Style x:Key="Button.TimelineOption" TargetType="Button" BasedOn="{StaticResource Button.TimelineIcon}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Small}" SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Surface.4}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Text.Tertiary}"/>
            </Trigger>
            <Trigger Property="Tag">
              <Trigger.Value><sys:Boolean>True</sys:Boolean></Trigger.Value>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Red.Subtle}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Red.Dark}"/>
              <Setter Property="Foreground" Value="{StaticResource Brush.Red.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Black}"/>
              <Setter TargetName="Content" Property="Margin" Value="0,1,0,-1"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}"/>
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Border}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Red}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Red}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Small}">
            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Red.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Red.Pressed}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Red.Dark}" />
              <Setter TargetName="Content" Property="Margin" Value="0,1,0,-1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Surface.3}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Dialog.Cancel" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Width" Value="112" />
    <Setter Property="IsCancel" Value="True" />
  </Style>

  <Style x:Key="Button.Dialog.Confirm" TargetType="Button" BasedOn="{StaticResource Button.Primary}">
    <Setter Property="Width" Value="112" />
    <Setter Property="IsDefault" Value="True" />
  </Style>

  <Style x:Key="Button.Ghost" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
  </Style>

  <Style x:Key="Button.Danger" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{StaticResource Brush.Red.Subtle}" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Red.Dark}" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Red.Hover}" />
  </Style>

  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Width" Value="32" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" />
  </Style>

  <Style x:Key="Button.Caption" TargetType="Button" BasedOn="{StaticResource Button.Ghost}">
    <Setter Property="Width" Value="46" />
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource Focus.Caption}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="UseLayoutRounding" Value="True" />
    <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Chrome"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="0"
                  SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Content"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Surface.3}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Black}" />
              <Setter TargetName="Content" Property="Margin" Value="0,1,0,-1" />
            </Trigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Tag" Value="Close" />
                <Condition Property="IsMouseOver" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Red}" />
              <Setter Property="Foreground" Value="White" />
            </MultiTrigger>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Tag" Value="Close" />
                <Condition Property="IsPressed" Value="True" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Red.Pressed}" />
              <Setter Property="Foreground" Value="White" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Button.Caption.Close" TargetType="Button" BasedOn="{StaticResource Button.Caption}">
    <Setter Property="Tag" Value="Close" />
  </Style>

  <Style x:Key="Toggle.Segment" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Chrome"
                  Padding="{TemplateBinding Padding}"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource Radius.Small}">
            <ContentPresenter x:Name="Content" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Surface.3}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Red.Subtle}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Red.Dark}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Red.Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Chrome" Property="Background" Value="{StaticResource Brush.Black}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Red.Dark}" />
              <Setter TargetName="Content" Property="Margin" Value="0,1,0,-1" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Disabled}" />
              <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Segment}" />

  <Style x:Key="Toggle.ExpanderHeader"
         TargetType="ToggleButton"
         BasedOn="{StaticResource Toggle.Segment}">
    <Setter Property="Height" Value="36" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style x:Key="Toggle.TrackState" TargetType="ToggleButton" BasedOn="{StaticResource Toggle.Segment}">
    <Setter Property="Width" Value="25" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style x:Key="Toggle.Switch" TargetType="ToggleButton">
    <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
    <Setter Property="Width" Value="36" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Track"
                  Width="36"
                  Height="20"
                  Background="{StaticResource Brush.Surface.4}"
                  BorderBrush="{StaticResource Brush.Border.Strong}"
                  BorderThickness="1"
                  CornerRadius="10">
            <Ellipse x:Name="Knob"
                     Width="14"
                     Height="14"
                     Margin="2"
                     HorizontalAlignment="Left"
                     Fill="{StaticResource Brush.Text.Secondary}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Text.Tertiary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Red.Dark}" />
              <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource Brush.Red}" />
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Fill" Value="White" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Track" Property="Background" Value="{StaticResource Brush.Black}" />
              <Setter TargetName="Knob" Property="Opacity" Value="0.72" />
            </Trigger>
