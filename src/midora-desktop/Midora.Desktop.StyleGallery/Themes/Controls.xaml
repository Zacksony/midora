            <ContentPresenter VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Red.Hover}" />
              <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource Brush.Red}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Brush.Red}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
