  <CornerRadius x:Key="Radius.Medium">5</CornerRadius>
  <CornerRadius x:Key="Radius.Large">8</CornerRadius>
  <Thickness x:Key="Thickness.ControlPadding">12,0</Thickness>
  <Thickness x:Key="Thickness.CardPadding">16</Thickness>

  <FontFamily x:Key="Font.UI">/Midora.Desktop.Presentation;Component/Assets/Fonts/Sora/#Sora</FontFamily>
  <FontFamily x:Key="Font.Mono">/Midora.Desktop.Presentation;Component/Assets/Fonts/JetBrainsMono/#JetBrains Mono</FontFamily>
  <sys:Double x:Key="FontSize.Caption"
              xmlns:sys="clr-namespace:System;assembly=System.Runtime">11</sys:Double>
  <sys:Double x:Key="FontSize.Body"
              xmlns:sys="clr-namespace:System;assembly=System.Runtime">12</sys:Double>
  <sys:Double x:Key="FontSize.Title"
              xmlns:sys="clr-namespace:System;assembly=System.Runtime">16</sys:Double>
