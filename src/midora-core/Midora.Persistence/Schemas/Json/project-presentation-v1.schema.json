{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Midora Project presentation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "allTracksMode",
    "trackOnionPresets",
    "subVoiceOnionPresets"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "allTracksMode": { "enum": ["raw", "compiled"] },
    "trackOnionPresets": {
      "type": "array",
      "items": { "$ref": "#/$defs/trackPreset" }
    },
    "subVoiceOnionPresets": {
      "type": "array",
      "items": { "$ref": "#/$defs/subVoicePreset" }
    }
  },
  "$defs": {
    "opacity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "trackPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetTrackId", "enabled", "opacity", "sourceTrackIds"],
      "properties": {
        "targetTrackId": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "enabled": { "type": "boolean" },
        "opacity": { "$ref": "#/$defs/opacity" },
        "sourceTrackIds": {
          "type": "array",
          "items": { "$ref": "common-v1.schema.json#/$defs/stableId" }
        }
      }
    },
    "subVoicePreset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventInstrumentId",
        "targetSubVoiceId",
        "enabled",
        "opacity",
        "sourceSubVoiceIds"
      ],
      "properties": {
        "eventInstrumentId": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "targetSubVoiceId": { "$ref": "common-v1.schema.json#/$defs/stableId" },
        "enabled": { "type": "boolean" },
        "opacity": { "$ref": "#/$defs/opacity" },
        "sourceSubVoiceIds": {
          "type": "array",
          "items": { "$ref": "common-v1.schema.json#/$defs/stableId" }
        }
      }
    }
  }
}
