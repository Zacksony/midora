<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\midora-common\Midora.Common\Midora.Common.csproj" />
    <ProjectReference Include="..\Midora.Mapping.Contract.V2\Midora.Mapping.Contract.V2.csproj" />
    <ProjectReference Include="..\Midora.Domain\Midora.Domain.csproj" />
    <ProjectReference Include="..\..\midora-midi\Midora.Midi\Midora.Midi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Midora.Compiler.Tests" />
    <InternalsVisibleTo Include="Midora.MidiExport.Tests" />
  </ItemGroup>
  <Target Name="RemoveLegacyMappingReferencePack" BeforeTargets="PrepareForBuild">
    <RemoveDir Directories="$(OutDir)mapping-reference-pack"
               Condition="Exists('$(OutDir)mapping-reference-pack')" />
  </Target>
</Project>
